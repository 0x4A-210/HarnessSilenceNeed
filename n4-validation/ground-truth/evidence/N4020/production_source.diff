+pri func decoder.apply_alph_chunk!(dst: ptr base.pixel_buffer, workbuf: slice base.u8) {
+    var y   : base.u32
+    var x   : base.u32
+    var tab : table base.u8
+    var row : slice base.u8
+    var d   : base.u64
+    var s   : base.u64
+
+    tab = args.dst.plane(p: 0)
+    y = 0
+    while y < this.height {
+        assert y < 0x4000 via "a < b: a < c; c <= b"(c: this.height)
+
+        row = tab.row_u32(y: y)
+
+        x = 0
+        while x < this.width,
+                inv y < 0x4000,
+        {
+            assert x < 0x4000 via "a < b: a < c; c <= b"(c: this.width)
+
