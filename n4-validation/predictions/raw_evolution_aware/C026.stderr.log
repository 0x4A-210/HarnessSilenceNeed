     // but (0x00, 0x00, 0x00) is a dark green.
     if this.components_workbuf_offsets[4] <= args.workbuf.length() {
         args.workbuf[.. this.components_workbuf_offsets[4]].bulk_memset!(byte_value: 0x80)
