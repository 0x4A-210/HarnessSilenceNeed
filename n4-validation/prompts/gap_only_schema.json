{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "gap_exists", "gap_type", "confidence", "affected_functions", "reason", "evidence", "recommended_action"],
  "properties": {
    "case_id": {"type": "string"},
    "gap_exists": {"type": "boolean"},
    "gap_type": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "affected_functions": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "recommended_action": {"type": "string"}
  }
}
