FROM gcr.io/oss-fuzz/libarchive:latest
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends bison flex gettext pkg-config ninja-build meson libonig-dev libreadline-dev libogg-dev liblzma-dev zlib1g-dev libssl-dev libexpat1-dev libevent-dev libxml2-dev libtool-bin curl xz-utils libjpeg-dev libyaml-dev && rm -rf /var/lib/apt/lists/*
RUN cd /tmp && curl -fL --retry 2 https://ftp.gnu.org/gnu/autoconf/autoconf-2.72.tar.xz -o autoconf.tar.xz && tar xf autoconf.tar.xz && cd autoconf-2.72 && ./configure --prefix=/opt/autotools && make -j3 && make install && cd /tmp && rm -rf autoconf-2.72 autoconf.tar.xz
ENV PATH=/opt/autotools/bin:$PATH
RUN python3 -m pip install --upgrade pip setuptools && python3 -m pip install -r /fuzz-introspector/requirements.txt && python3 -m pip install -e /fuzz-introspector/src
