 2075|       |
 2076|       |    /* Note : the wording of the specification
 2077|       |     * allows compressed block to be sized exactly ZSTD_blockSizeMax(dctx).
 2078|       |     * This generally does not happen, as it makes little sense,
 2079|       |     * since an uncompressed block would feature same size and have no decompression cost.
 2080|       |     * Also, note that decoder from reference libzstd before < v1.5.4
 2081|       |     * would consider this edge case as an error.
 2082|       |     * As a consequence, avoid generating compressed blocks of size ZSTD_blockSizeMax(dctx)
 2083|       |     * for broader compatibility with the deployed ecosystem of zstd decoders */
 2084|    142|    RETURN_ERROR_IF(srcSize > ZSTD_blockSizeMax(dctx), srcSize_wrong, "");
