       format.print_newline();
       depth--;
       format.print_indents(depth);
       if (iter.tape_ref_type() == tape_type::END_ARRAY) {
         format.end_array();
       } else {
         format.end_object();
       }
       iter.json_index++;
     }
 
     // Stop when we're at depth 0
   } while (depth != 0);
 
   format.print_newline();
 }
