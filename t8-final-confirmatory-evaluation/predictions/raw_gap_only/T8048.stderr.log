       int numdots = 0, valid = 1;
       const char *p;
       for (p = name; *p; p++)
         {
           if (!ISDIGIT(*p) && *p != '.') {
             valid = 0;
             break;
           } else if (*p == '.') {
             numdots++;
           }
         }
 
       /* if we don't have 3 dots, it is illegal
        * (although inet_pton doesn't think so).
