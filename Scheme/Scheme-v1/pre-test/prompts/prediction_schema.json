{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "maintenance_needed",
    "confidence",
    "change_types",
    "affected_functions",
    "reason",
    "evidence",
    "recommended_action"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^C[0-9]{3}$"},
    "maintenance_needed": {"type": "boolean"},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "change_types": {"type": "array", "items": {"type": "string"}},
    "affected_functions": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "recommended_action": {"type": "string"}
  }
}
