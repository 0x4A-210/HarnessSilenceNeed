 #include <stdio.h>
@@ -526,13 +526,13 @@ BROTLI_MIN_MAX(size_t) BROTLI_MIN_MAX(uint32_t) BROTLI_MIN_MAX(uint8_t)
 }
 
 #if BROTLI_64_BITS
