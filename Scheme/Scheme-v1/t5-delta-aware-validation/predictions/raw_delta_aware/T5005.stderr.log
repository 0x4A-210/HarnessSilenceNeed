 {
   ares_status_t  status = ARES_SUCCESS;
   ares_timeval_t tout;
 
   if (!ares_threadsafety()) {
     return ARES_ENOTIMP;
   }
 
   if (channel == NULL) {
     return ARES_EFORMERR;
   }
 
