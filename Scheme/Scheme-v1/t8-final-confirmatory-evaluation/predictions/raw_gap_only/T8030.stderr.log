  simdjson_unused simdjson::dom::element elem;
  simdjson_unused auto error = parser.parse(strings[1]).get(elem);

  if (error)
    return 0;

#define CASE(num, fun)                                                         \
  case num: {                                                                  \
    simdjson_unused auto v = elem.fun();                                                       \
    break;                                                                     \
  }
#define CASE2(num, fun)                                                        \
