      case 31: { NulOStream os;
        simdjson_unused auto dumpstatus = elem.dump_raw_tape(os);} ;break;
    default:
      return 0;
    }
#undef CASE
#undef CASE2

#if SIMDJSON_EXCEPTIONS
  } catch (std::exception &) {
