    const std::string filename = "/dev/shm/fuzz_padded.tmp";
    {
      std::ofstream file(filename);
      assert(file);
      const long ssize = static_cast<long>(fd.Size);
      file.write(fd.chardata(), ssize);
      assert(file.tellp() == ssize);
