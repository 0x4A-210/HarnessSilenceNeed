             const uint8_t *inp = decoder_buf;                                                                                      \
             int ret = h2o_qpack_encoder_handle_input(enc, &inp, p, &err_desc);                                                     \
             assert(ret == 0);                                                                                                      \
             assert(inp == p);                                                                                                      \
         }                                                                                                                          \
         ++stream_id;                                                                                                               \
