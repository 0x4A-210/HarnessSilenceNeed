         /* chop LF */
         assert(line[len - 1] == '\n');
         line[--len] = '\0';
 
         if (line[0] == '\0') {
             /* empty line */
             EMIT();
         } else if (line[0] == '#') {
             /* skip comment */
         } else {
             /* split line into name and value */
             size_t i;
             for (i = 1; i < len; ++i)
                 if (isspace(line[i]))
                     break;
             assert(i < len);
             h2o_iovec_t name = h2o_strdup(&pool, line, i);
             for (++i; i < len; ++i)
                 if (!isspace(line[i]))
                     break;
             assert(i <= len);
             h2o_iovec_t value = h2o_strdup(&pool, line + i, len - i);
             /* handle header */
             if (line[0] == ':') {
