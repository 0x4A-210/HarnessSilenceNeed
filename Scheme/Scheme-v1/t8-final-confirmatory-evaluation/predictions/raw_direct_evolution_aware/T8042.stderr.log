                     } else if (h2o_memis(name.base, name.len, H2O_STRLIT(":scheme"))) {
                         static const h2o_url_scheme_t *schemes[] = {&H2O_URL_SCHEME_HTTP, &H2O_URL_SCHEME_HTTPS, NULL};
