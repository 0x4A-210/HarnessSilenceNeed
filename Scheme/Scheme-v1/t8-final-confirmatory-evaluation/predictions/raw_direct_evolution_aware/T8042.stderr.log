     if (argc < 1) {
         fprintf(stderr, "no URL\n");
         exit(EXIT_FAILURE);
     }
     req.target = argv[0];
 
     if (req.body_size != 0) {
         iov_filler.base = h2o_mem_alloc(chunk_size);
         memset(iov_filler.base, 'a', chunk_size);
         iov_filler.len = chunk_size;
