+  if (opts == NULL) {
+    return 65535;
+  }
+
+  if (idx >= opts->cnt) {
+    return 65535;
+  }
+
+  if (val) {
+    *val = opts->optval[idx].val;
+  }
+  if (val_len) {
+    *val_len = opts->optval[idx].val_len;
+  }
+
+  return opts->optval[idx].opt;
