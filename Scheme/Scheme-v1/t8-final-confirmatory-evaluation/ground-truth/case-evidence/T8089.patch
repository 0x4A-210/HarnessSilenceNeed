+	__m128i l0 = _mm_sub_epi16(_mm_setzero_si128(), _mm_and_si128(i0, _mm_set1_epi16(1)));
+	__m128i r0 = _mm_xor_si128(l0, _mm_srli_epi16(i0, 1));
