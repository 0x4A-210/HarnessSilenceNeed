      WUFFS_GIF__QUIRK_REJECT_EMPTY_FRAME,
      WUFFS_GIF__QUIRK_REJECT_EMPTY_PALETTE,
      0,
  };

  for (uint32_t i = 0; quirks[i]; i++) {
    uint64_t bit = 1 << (i & 63);
    if (hash & bit) {
      wuffs_gif__decoder__set_quirk(dec, quirks[i], 1);
    }
  }
