diff --git a/std/crc64/common_up_x86_sse42.wuffs b/std/crc64/common_up_x86_sse42.wuffs
new file mode 100644
index 00000000..189a175f
--- /dev/null
+++ b/std/crc64/common_up_x86_sse42.wuffs
@@ -0,0 +1,145 @@
+// Copyright 2024 The Wuffs Authors.
+//
