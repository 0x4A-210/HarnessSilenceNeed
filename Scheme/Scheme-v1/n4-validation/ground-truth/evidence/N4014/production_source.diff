 pub func ecma_hasher.update!(x: roslice base.u8) {
+    if this.state == 0 {
+        choose up = [
+                up_x86_sse42]
+    }
+    this.up!(x: args.x)
+}
+
+pub func ecma_hasher.update_u64!(x: roslice base.u8) base.u64 {
+    this.update!(x: args.x)
+    return this.checksum_u64()
+}
+
+pri func ecma_hasher.up!(x: roslice base.u8),
+        choosy,
+{
     var s : base.u64
     var p : roslice base.u8
 
     s = 0xFFFF_FFFF_FFFF_FFFF ^ this.state
 
     // Use the same slicing-by-M algorithm as for std/crc32, with M = 8.
     iterate (p = args.x)(length: 8, advance: 8, unroll: 1) {
         s ^= ((p[0x00] as base.u64) << 0) |
                 ((p[0x01] as base.u64) << 8) |
                 ((p[0x02] as base.u64) << 16) |
                 ((p[0x03] as base.u64) << 24) |
                 ((p[0x04] as base.u64) << 32) |
@@ -42,29 +57,24 @@ pub func ecma_hasher.update!(x: roslice base.u8) {
