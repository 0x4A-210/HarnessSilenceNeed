diff --git a/std/lzma/decode_bitstream_slow.wuffs b/std/lzma/decode_bitstream_slow.wuffs
new file mode 100644
index 00000000..2bb9be6d
--- /dev/null
+++ b/std/lzma/decode_bitstream_slow.wuffs
@@ -0,0 +1,835 @@
+// Copyright 2023 The Wuffs Authors.
