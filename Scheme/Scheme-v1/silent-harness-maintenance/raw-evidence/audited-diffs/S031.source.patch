                 ac_ht_fast = ac_huff_table_fast[bits >> 56] as base.u32
 
-                // Load at least 31 bits, by keeping 56 .. 64 loaded.
+                // Load at least 47 bits, by keeping 56 .. 64 loaded.
                 //
