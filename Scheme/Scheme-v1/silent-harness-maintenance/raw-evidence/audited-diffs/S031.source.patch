+                //
+                // LOOK-UP: "ac_ht_fast = etc" conceptually happens here, just
+                // before deriving ac_bl from ac_ht_fast.
                 ac_bl = ac_ht_fast >> 8
                 if n_bits >= ac_bl {
                     ac_symbol = 0xFF & ac_ht_fast
