diff --git a/test/std-format-test.cc b/test/std-format-test.cc
index c4fb5a270734cf7a23f11d1cb85335b21375985e..8bf4b6d1a1b683e5575d532a0231b4879cf88f2c 100644
--- a/test/std-format-test.cc
