{
  "verdict": "needs_update",
  "status": "introduced",
  "candidates": [
    {
      "candidate_id": "c1",
      "source_id": "explicit_16_byte_salt",
      "origin": "discover",
      "kind": "call",
      "change_ids": [
        "g0009",
        "g0023"
      ],
      "requirement": "Exercise the supported caller-supplied 16-byte hash-salt capability on a parser before parsing.",
      "target_route": "After XML_ParserCreate or XML_ParserCreateNS and before XML_Parse, configure that same parser with XML_SetHashSalt16Bytes and a non-NULL 16-byte array; then parse a finite valid document such as <a/>.",
      "failure_condition": "ParseOneInput always calls XML_SetHashSalt with an unsigned-long value. That call sets the upper 64-bit key half to zero and cannot invoke XML_SetHashSalt16Bytes for any input.",
      "alternative_paths": "A zero value passed to the old setter may permit automatic salt generation, but it does not execute the caller-supplied 16-byte setter. Child creation copies the existing key and likewise does not invoke it.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
  "decisions": [
    {
      "candidate_id": "c1",
      "decision": "keep",
      "errors": [],
      "obligation_class": "target_coverage",
      "citation_errors": [],
      "cited_paths": [
        "expat/lib/expat.h",
        "input/harness/build/build.sh",
        "input/harness/expat/fuzz/xml_parse_fuzzer.c",
        "input/source/expat/lib/xmlparse.c"
      ]
    }
  ],
  "scope_complete": false,
  "timing": {
    "status": "introduced",
    "gap": true,
    "introduced_by_this_change": true,
    "claims": [
      {
        "claim_id": "c1",
        "status": "introduced",
        "necessary": "yes",
        "before": {
          "requirement": "Exercise caller-supplied 16-byte salt through XML_SetHashSalt16Bytes before parsing.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The before version has only the unsigned-long setter; the 16-byte setter did not yet exist. The harness's old setter call exercised the narrower existing API, not this later capability.",
          "source_evidence": [
            {
              "evidence_id": "loc-c33e2e056baef261c6227df1",
              "quote": "XMLPARSEAPI(int)\nXML_SetHashSalt(XML_Parser parser, unsigned long hash_salt);\n"
            },
            {
              "evidence_id": "loc-df1559e90c3fbe987a222b10",
              "quote": "Verified preimage file expat/lib/xmlparse.c has no function definition named XML_SetHashSalt16Bytes. The entire after definition consists of added lines. This establishes absence in this file only; other implementations or equivalent paths must still be considered."
            },
            {
              "evidence_id": "loc-02981031f8cb03248636139c",
              "quote": "int XMLCALL\nXML_SetHashSalt(XML_Parser parser, unsigned long hash_salt) {\n  if (parser == NULL)\n    return 0;\n\n  const XML_Parser rootParser = getRootParserOf(parser, NULL);\n  assert(! rootParser->m_parentParser);\n\n  /* block after XML_Parse()/XML_ParseBuffer() has been called */\n  if (parserBusy(rootParser))\n    return 0;\n  rootParser->m_hash_secret_salt = hash_salt;\n  return 1;\n}\n"
            }
          ]
        },
        "after": {
          "requirement": "Call XML_SetHashSalt16Bytes on the parser with a non-NULL 16-byte array before parsing, then parse a finite valid document.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The added setter loads all 16 supplied bytes. The fixed harness calls XML_SetHashSalt instead, which forces the first key half to zero; no input changes that call.",
          "source_evidence": [
            {
              "evidence_id": "loc-f7c44124233ddef13f962c3d",
              "quote": "XMLPARSEAPI(XML_Bool)\nXML_SetHashSalt16Bytes(XML_Parser parser, const uint8_t entropy[16]);\n"
            },
            {
              "evidence_id": "loc-dbe90814bfba620244b14c63",
              "quote": "XML_Bool XMLCALL\nXML_SetHashSalt16Bytes(XML_Parser parser, const uint8_t entropy[16]) {\n  if (parser == NULL)\n    return XML_FALSE;\n\n  if (entropy == NULL)\n    return XML_FALSE;\n\n  const XML_Parser rootParser = getRootParserOf(parser, NULL);\n  assert(! rootParser->m_parentParser);\n\n  /* block after XML_Parse()/XML_ParseBuffer() has been called */\n  if (parserBusy(rootParser))\n    return XML_FALSE;\n\n  sip_tokey(&(rootParser->m_hash_secret_salt_128), entropy);\n\n  rootParser->m_hash_secret_salt_set = XML_TRUE;\n\n  ENTROPY_DEBUG(\"explicit(16)\", rootParser->m_hash_secret_salt_128);\n\n  return XML_TRUE;\n}\n"
            },
            {
              "evidence_id": "loc-3a54742bd963d91502cab687",
              "quote": "int XMLCALL\nXML_SetHashSalt(XML_Parser parser, unsigned long hash_salt) {\n  if (parser == NULL)\n    return 0;\n\n  const XML_Parser rootParser = getRootParserOf(parser, NULL);\n  assert(! rootParser->m_parentParser);\n\n  /* block after XML_Parse()/XML_ParseBuffer() has been called */\n  if (parserBusy(rootParser))\n    return 0;\n\n  rootParser->m_hash_secret_salt_128.k[0] = 0;\n  rootParser->m_hash_secret_salt_128.k[1] = hash_salt;\n\n  if (hash_salt != 0) { // to remain backwards compatible\n    rootParser->m_hash_secret_salt_set = XML_TRUE;\n\n    if (sizeof(unsigned long) == 4)\n      ENTROPY_DEBUG(\"explicit(4)\", rootParser->m_hash_secret_salt_128);\n    else\n      ENTROPY_DEBUG(\"explicit(8)\", rootParser->m_hash_secret_salt_128);\n  }\n\n  return 1;\n}\n"
            }
          ]
        },
        "same_blocker": "not_applicable",
        "reason": "There was no before-version 16-byte setter to block. The old harness's fixed unsigned-long setter call becomes a coverage constraint only after the new API is added.",
        "error": null,
        "missing_information": []
      }
    ],
