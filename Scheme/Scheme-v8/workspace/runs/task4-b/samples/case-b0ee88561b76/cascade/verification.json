      "source_id": "c-nan-cbor-roundtrip",
      "origin": "review-1",
      "kind": "check",
      "change_ids": [
        "g0001"
      ],
      "requirement": "The existing CBOR round-trip equality assertion must hold for CBOR inputs accepted by from_cbor.",
      "target_route": "Input bytes 0xf9 0x7e 0x00 decode as half-precision NaN. Float construction preserves NaN; to_cbor emits it as a double; the second from_cbor returns NaN; the entry compares the two values.",
      "failure_condition": "The float equality branch uses floating-point ==, so j1 == j2 is false and the existing assertion fails.",
      "alternative_paths": "The entry always performs the comparison after successful parsing and serialization. Its catches handle exceptions, not a failed assertion; equality does not use dump or normalize NaN.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
  "decisions": [
    {
