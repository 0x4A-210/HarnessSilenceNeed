          "origin": "discover",
          "kind": "lifecycle",
          "change_ids": [
            "g0015",
            "g0020"
          ],
          "requirement": "Initialize the per-process PGPROC with InitProcess before calling BaseInit and its InitBufferPoolAccess helper.",
          "target_route": "LLVMFuzzerInitialize calls FuzzerInitialize, which calls BaseInit, then InitProcess, then InitPostgres.",
          "failure_condition": "BaseInit requires MyProc and calls InitBufferPoolAccess, which also requires MyProc before registering its exit callback. On this route, InitProcess has not yet run.",
          "alternative_paths": "The complete initializer has no earlier InitProcess call or guard; fuzz input is supplied only after initialization.",
          "discovery_necessary": true,
          "discovery_established": true
        },
        {
          "candidate_id": "c2",
          "source_id": "missing_shared_memory_initialization",
          "origin": "review-1",
          "kind": "lifecycle",
          "change_ids": [
            "g0015",
            "g0020"
          ],
          "requirement": "Establish ProcGlobal through shared memory initialization before calling InitProcess.",
          "target_route": "FuzzerInitialize calls BaseInit and then InitProcess without calling CreateSharedMemoryAndSemaphores.",
          "failure_condition": "ProcGlobal starts NULL, and InitProcess unconditionally raises PANIC when it remains NULL.",
          "alternative_paths": "PostmasterMain and SubPostmasterMain initialize or attach shared memory on separate server routes; the fuzzer initializer enters neither.",
          "discovery_necessary": true,
          "discovery_established": true
        },
        {
          "candidate_id": "c3",
          "source_id": "type_name_parse_result_treated_as_raw_stmt",
          "origin": "review-1",
          "kind": "input",
          "change_ids": [
            "g0015",
            "g0016",
            "g0017",
            "g0019",
            "g0020",
            "g0021"
          ],
          "requirement": "Pass a RawStmt to pg_analyze_and_rewrite, or handle the TypeName returned by RAW_PARSE_TYPE_NAME without treating it as a RawStmt.",
          "target_route": "For a valid type name such as int4, the target calls raw_parser with RAW_PARSE_TYPE_NAME, then treats the returned list element as RawStmt and sends it to pg_analyze_and_rewrite.",
          "failure_condition": "The grammar returns a TypeName directly in RAW_PARSE_TYPE_NAME mode. The harness accesses that object as a RawStmt, so its statement field and analysis input are invalid.",
          "alternative_paths": "The ordinary stmtmulti grammar wraps statements in RawStmt, but the target explicitly selects the distinct type name mode. Input bytes cannot select the ordinary mode.",
          "discovery_necessary": true,
          "discovery_established": true
        }
