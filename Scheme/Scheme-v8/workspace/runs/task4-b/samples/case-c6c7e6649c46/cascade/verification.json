      ],
      "requirement": "Initialize notes before the entry uses the assembler's notes-backed assembly state.",
      "target_route": "LLVMFuzzerTestOneInput writes a source file, calls read_begin, then calls perform_an_assembly_pass. That pass creates sections; alloc_seginfo stores section information in notes.",
      "failure_condition": "For an ordinary input that reaches section setup, the target has never executed the notes initialization relocated from read_begin to main.",
      "alternative_paths": "The complete entry has no call to main or obstack_begin; read_begin initializes cond_obstack, not notes. Input bytes cannot select the bypassed setup.",
      "discovery_necessary": true,
      "discovery_established": true
    },
    {
      "candidate_id": "c2",
      "source_id": "conditional_cleanup",
      "origin": "discover",
      "kind": "lifecycle",
      "change_ids": [
        "g0008"
      ],
      "requirement": "Complete the read_begin lifecycle by invoking read_end so the changed conditional-obstack release is exercised.",
      "target_route": "Each entry calls read_begin, assembles its file, performs partial cleanup, and returns without read_end.",
      "failure_condition": "No input can execute the changed release in read_end through the fixed entry's call sequence.",
      "alternative_paths": "The complete entry has no read_end call; subsegs_end no longer releases cond_obstack and is also uncalled.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
