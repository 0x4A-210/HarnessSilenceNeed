          "change_ids": [
            "g0016"
          ],
          "requirement": "Exercise the default-enabled reparse deferral skip for a partial XML token by making a subsequent nonfinal parse call on the same parser before finalization.",
          "target_route": "LLVMFuzzerTestOneInput creates each parser, then ParseOneInput calls XML_Parse once with isFinal=0 and once with isFinal=1; XML_Parse reaches callProcessor directly or through XML_ParseBuffer.",
          "failure_condition": "The first call starts with m_partialTokenBytesBefore=0, so its doubling condition is satisfied. The second call sets finalBuffer and bypasses the deferral guard. No target parser receives the later nonfinal call needed for the skip.",
          "alternative_paths": "The namespace and external-entity parsers repeat the same two-call pattern. Reset occurs only after those calls and no parser is reused afterward. The separate parse-buffer fuzzer is a different target.",
          "discovery_necessary": true,
          "discovery_established": true
        }
      ],
