      "requirement": "Exercise parser cleanup with an unattached saved comment after a parse error.",
      "target_route": "Construct the same parser with UCL_PARSER_SAVE_COMMENTS, parse the finite input `#x\\n?`, and free the parser after the error.",
      "failure_condition": "The old entry constructs with flag 0, so it cannot save a comment; it also returns before ucl_parser_free when an error is reported. The new cleanup is never exercised.",
      "alternative_paths": "The single entry has no other constructor or cleanup call. Successful parsing with flag 0 cannot create last_comment.",
      "discovery_necessary": true,
      "discovery_established": true
    },
