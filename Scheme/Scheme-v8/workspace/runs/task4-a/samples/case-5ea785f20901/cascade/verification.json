      "requirement": "Free the parser on the entry's parse-error path.",
      "target_route": "For the finite input `{`, the entry constructs a parser, calls ucl_parser_add_string, observes the unmatched-brace error, and returns.",
      "failure_condition": "The error branch returns without calling ucl_parser_free, leaving the allocated parser and its owned state unreleased.",
      "alternative_paths": "The entry's only ucl_parser_free call follows the error guard; no later cleanup runs on that branch.",
      "discovery_necessary": true,
