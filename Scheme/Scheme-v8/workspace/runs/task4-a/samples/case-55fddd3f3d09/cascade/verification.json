          "harness_status": "unsat",
          "reason": "The old harness passes LZ4_compressBound(1), or 17, for a one-byte input. The producer stores 17 and its first preference read accesses data[13].",
          "source_evidence": [
            {
              "evidence_id": "loc-1da8b49b934e502f34ded9fa",
              "quote": "FUZZ_dataProducer_t *FUZZ_dataProducer_create(const uint8_t *data, size_t size) {\n  FUZZ_dataProducer_t *producer = malloc(sizeof(FUZZ_dataProducer_t));\n\n  FUZZ_ASSERT(producer != NULL);\n\n  producer->data = data;\n  producer->size = size;\n  return producer;\n}\n"
            },
            {
              "evidence_id": "loc-adc29a374d7de315c7548f43",
              "quote": "int LZ4_compressBound(int isize)  { return LZ4_COMPRESSBOUND(isize); }\n"
            },
            {
              "evidence_id": "loc-e21e61d730f85ceb547c44a2",
              "quote": "#define LZ4_COMPRESSBOUND(isize)  ((unsigned)(isize) > (unsigned)LZ4_MAX_INPUT_SIZE ? 0 : (isize) + ((isize)/255) + 16)\n"
            },
            {
              "evidence_id": "loc-07388d34f92ea66c1f3613d4",
              "quote": "LZ4F_preferences_t FUZZ_dataProducer_preferences(FUZZ_dataProducer_t* producer)\n{\n    LZ4F_preferences_t prefs = LZ4F_INIT_PREFERENCES;\n    prefs.frameInfo = FUZZ_dataProducer_frameInfo(producer);\n    prefs.compressionLevel = FUZZ_dataProducer_range32(producer, 0, LZ4HC_CLEVEL_MAX + 3) - 3;\n"
            },
            {
              "evidence_id": "loc-464b9a24adb019238ddf02c4",
              "quote": "LZ4F_frameInfo_t FUZZ_dataProducer_frameInfo(FUZZ_dataProducer_t* producer)\n{\n    LZ4F_frameInfo_t info = LZ4F_INIT_FRAMEINFO;\n    info.blockSizeID = FUZZ_dataProducer_range32(producer, LZ4F_max64KB - 1, LZ4F_max4MB);\n    if (info.blockSizeID < LZ4F_max64KB) {\n        info.blockSizeID = LZ4F_default;\n    }\n    info.blockMode = FUZZ_dataProducer_range32(producer, LZ4F_blockLinked, LZ4F_blockIndependent);\n"
            },
            {
              "evidence_id": "loc-99323cd6a251c1d3fa0dc4d6",
              "quote": "uint32_t FUZZ_dataProducer_range32(FUZZ_dataProducer_t* producer,\n    uint32_t min, uint32_t max)\n{\n    size_t const seed = FUZZ_dataProducer_retrieve32(producer);\n    return FUZZ_getRange_from_uint32(seed, min, max);\n}\n"
            },
            {
              "evidence_id": "loc-b35d5b5e8c4db96a968bfdf8",
              "quote": "uint32_t FUZZ_dataProducer_retrieve32(FUZZ_dataProducer_t *producer) {\n    const uint8_t* data = producer->data;\n    const size_t size = producer->size;\n    if (size == 0) {\n        return 0;\n    } else if (size < 4) {\n        producer->size -= 1;\n        return (uint32_t)data[size - 1];\n    } else {\n        producer->size -= 4;\n        return *(data + size - 4);\n    }\n}\n"
            }
          ]
        },
