      "origin": "discover",
      "kind": "input",
      "change_ids": [],
      "requirement": "Initialize the producer with the actual number of bytes available from the fuzz input.",
      "target_route": "LLVMFuzzerTestOneInput calls LZ4_compressBound(size), stores that result in the producer, then generates frame preferences through frameInfo, range32, and retrieve32.",
      "failure_condition": "With a one-byte input, the producer records size 17 and retrieve32 reads data[13], beyond the supplied input.",
      "alternative_paths": "Preference generation occurs before the frame operation for this input; later compression errors or cleanup cannot avoid the read.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
