  "candidates": [
    {
      "candidate_id": "c1",
      "source_id": "never_callout_context_option",
      "origin": "review-1",
      "kind": "configuration",
      "change_ids": [
        "g0020",
        "g0021",
        "g0022",
        "g0023",
        "g0024",
        "g0025"
      ],
      "requirement": "Set PCRE2_EXTRA_NEVER_CALLOUT on the compile context used to compile a pattern containing an explicit (?C) callout.",
      "target_route": "The fuzzer can supply (?C) as pattern bytes and passes its compile context to pcre2_compile.",
      "failure_condition": "The fuzzer never sets compile extra options. The created context retains the default value of zero, so input bytes cannot enable the new rejection branch.",
      "alternative_paths": "The ordinary compile-options mask does not set context extra options. Automatic callouts and match-time callout configuration do not exercise rejection of an explicit callout under PCRE2_EXTRA_NEVER_CALLOUT. The pcre2test and pcre2grep routes are separate executables.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
  "decisions": [
    {
      "candidate_id": "c1",
      "decision": "keep",
      "errors": [],
      "obligation_class": "target_coverage",
      "citation_errors": [],
      "cited_paths": [
        "input/harness/src/pcre2_fuzzsupport.c",
        "input/source/src/pcre2_compile.c",
        "input/source/src/pcre2_context.c"
      ]
    }
  ],
  "scope_complete": false,
  "timing": {
    "status": "introduced",
    "gap": true,
    "introduced_by_this_change": true,
    "claims": [
      {
        "claim_id": "c1",
        "status": "introduced",
        "necessary": "yes",
        "before": {
          "requirement": "No PCRE2_EXTRA_NEVER_CALLOUT rejection branch existed; compiling an explicit (?C) callout did not require enabling that option.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The before parser handles explicit callouts without the new option check.",
          "source_evidence": [
            {
              "evidence_id": "loc-5325e073e9af476712925450",
              "quote": "      /* ---- Callout with numerical or string argument ---- */\n\n      case CHAR_C:\n      if (++ptr >= ptrend) goto UNCLOSED_PARENTHESIS;\n\n      /* If the previous item was a condition starting (?(? an assertion,\n      optionally preceded by a callout, is expected. This is checked later on,\n      during actual compilation. However we need to identify this kind of\n      assertion in this pass because it must not be qualified. The value of\n      expect_cond_assert is set to 2 after (?(? is processed. We decrement it\n      for a callout - still leaving a positive value that identifies the\n      assertion. Multiple callouts or any other items will make it zero or\n      less, which doesn't matter because they will cause an error later. */\n\n      expect_cond_assert = prev_expect_cond_assert - 1;\n"
            },
            {
              "evidence_id": "loc-8c735e728a78d27a0445434b",
              "quote": "#define PUBLIC_COMPILE_EXTRA_OPTIONS \\\n   (PUBLIC_LITERAL_COMPILE_EXTRA_OPTIONS| \\\n    PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES|PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL| \\\n    PCRE2_EXTRA_ESCAPED_CR_IS_LF|PCRE2_EXTRA_ALT_BSUX| \\\n    PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK|PCRE2_EXTRA_ASCII_BSD| \\\n    PCRE2_EXTRA_ASCII_BSS|PCRE2_EXTRA_ASCII_BSW|PCRE2_EXTRA_ASCII_POSIX| \\\n    PCRE2_EXTRA_ASCII_DIGIT|PCRE2_EXTRA_PYTHON_OCTAL|PCRE2_EXTRA_NO_BS0)\n"
            }
          ]
        },
        "after": {
          "requirement": "Set PCRE2_EXTRA_NEVER_CALLOUT on the compile context and compile a pattern containing an explicit (?C) callout to exercise ERR103.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The parser reads extra options from the compile context and rejects the explicit callout only when the new bit is set. The fixed harness creates and passes a default context without setting compile extra options.",
          "source_evidence": [
            {
              "evidence_id": "loc-7c6b81551e8453d4f47116f6",
              "quote": "uint32_t xoptions = cb->cx->extra_options;\n"
            },
            {
              "evidence_id": "loc-da8beb39f5644890c646a2ab",
              "quote": "      /* ---- Callout with numerical or string argument ---- */\n\n      case CHAR_C:\n      if ((xoptions & PCRE2_EXTRA_NEVER_CALLOUT) != 0)\n        {\n        errorcode = ERR103;\n        goto FAILED;\n        }\n"
            },
            {
              "evidence_id": "loc-e4b46ab60c4c5408e2ed6caa",
              "quote": "pcre2_compile_context PRIV(default_compile_context) = {\n  { default_malloc, default_free, NULL },    /* Default memory handling */\n  NULL,                                      /* Stack guard */\n  NULL,                                      /* Stack guard data */\n  PRIV(default_tables),                      /* Character tables */\n  PCRE2_UNSET,                               /* Max pattern length */\n  PCRE2_UNSET,                               /* Max pattern compiled length */\n  BSR_DEFAULT,                               /* Backslash R default */\n  NEWLINE_DEFAULT,                           /* Newline convention */\n  PARENS_NEST_LIMIT,                         /* As it says */\n  0,                                         /* Extra options */\n  MAX_VARLOOKBEHIND,                         /* As it says */\n  PCRE2_OPTIMIZATION_ALL                     /* All optimizations enabled */\n  };\n\n/* The create function copies the default into the new memory, but must\noverride the default memory handling functions if a gcontext was provided. */\n\nPCRE2_EXP_DEFN pcre2_compile_context * PCRE2_CALL_CONVENTION\npcre2_compile_context_create(pcre2_general_context *gcontext)\n{\npcre2_compile_context *ccontext = PRIV(memctl_malloc)(\n  sizeof(pcre2_real_compile_context), (pcre2_memctl *)gcontext);\nif (ccontext == NULL) return NULL;\n*ccontext = PRIV(default_compile_context);\nif (gcontext != NULL)\n  *((pcre2_memctl *)ccontext) = *((pcre2_memctl *)gcontext);\nreturn ccontext;\n"
            },
            {
              "evidence_id": "loc-5736d9859e43c3380c7d81ec",
              "quote": "PCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION\npcre2_set_compile_extra_options(pcre2_compile_context *ccontext, uint32_t options)\n{\nccontext->extra_options = options;\nreturn 0;\n}\n"
            }
          ]
        },
        "same_blocker": "not_applicable",
        "reason": "The option-gated rejection was introduced after the before version. The harness's lack of a compile-extra-options setter blocks the after requirement; there was no corresponding before requirement.",
        "error": null,
        "missing_information": []
      }
