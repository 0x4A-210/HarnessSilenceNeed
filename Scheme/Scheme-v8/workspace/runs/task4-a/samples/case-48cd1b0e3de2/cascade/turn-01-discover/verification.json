        "established": true,
        "requirement": "Link the fuzzer against the archive produced by the relocated Autotools library target.",
        "target_route": "build.sh runs buildconf, configure, and make all, then links ares_parse_reply_fuzzer against $SRC/c-ares/.libs/libcares.a.",
        "failure_condition": "The root Makefile delegates to src/lib, where libcares.la is built; the recipe's root .libs/libcares.a path is not that output.",
        "alternative_paths": "The in-tree test rules use src/lib/libcares.la, but the OSS-Fuzz link command is direct and has no fallback path.",
        "source_evidence": [
          {
            "evidence_id": "loc-779da5739daac3576be2450a",
            "quote": "DISTCLEANFILES = include/ares_build.h\n\nDIST_SUBDIRS = include src test docs\n\nSUBDIRS = @BUILD_SUBDIRS@\n"
          },
          {
            "evidence_id": "loc-b261713803a9ae09e7928180",
            "quote": "AM_CPPFLAGS = -I$(top_builddir)/include \\\n              -I$(top_builddir)/src/lib \\\n              -I$(top_srcdir)/include\n\nlib_LTLIBRARIES = libcares.la\n"
          },
          {
            "evidence_id": "loc-b999cb400fa2083e9f482701",
            "quote": "# Makefile.inc provides the CSOURCES and HHEADERS defines\ninclude Makefile.inc\n\nlibcares_la_SOURCES = $(CSOURCES) $(HHEADERS)"
          },
          {
            "evidence_id": "loc-6862fc4160c8db8322f1eab5",
            "quote": "\nEXTRA_DIST = fuzzcheck.sh CMakeLists.txt Makefile.m32 Makefile.msvc README.md buildconf\narestest_LDADD = libgmock.la $(ARES_BLD_DIR)/src/lib/libcares.la $(PTHREAD_LIBS)\naresfuzz_LDADD = $(ARES_BLD_DIR)/src/lib/libcares.la\naresfuzzname_LDADD = $(ARES_BLD_DIR)/src/lib/libcares.la\ndnsdump_LDADD = $(ARES_BLD_DIR)/src/lib/libcares.la"
          }
        ],
        "harness_evidence": [
