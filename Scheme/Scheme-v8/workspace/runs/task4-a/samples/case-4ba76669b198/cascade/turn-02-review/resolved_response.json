      "id": "context-error-handler-coverage",
      "change_ids": [
        "g0001",
        "g0002",
        "g0004",
        "g0012",
        "g0026",
        "g0045"
      ],
      "kind": "call",
      "necessary": true,
      "established": true,
      "requirement": "Exercise the new per-context structured error-handler route on the XInclude context used by this target.",
      "target_route": "After xmlXIncludeNewContext, register a structured handler and data before xmlXIncludeProcessNode. A well-formed document containing an xi:include with an unsupported parse value reaches an XInclude error through the target's existing processing operation.",
      "failure_condition": "The old target never calls xmlXIncludeSetErrorHandler, so every input leaves errorHandler null and cannot execute the new per-context callback route.",
      "alternative_paths": "The target installs only a generic global error function. That does not populate the XInclude context's handler and data, and no input changes the target's call sequence.",
