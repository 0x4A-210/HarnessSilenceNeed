        "claims": [
          {
            "claim_id": "c1",
            "status": "preexisting",
            "necessary": "yes",
            "before": {
              "requirement": "Exercise dumping of a supported constructed value deep enough to reach depth JSON_PARSER_MAX_DEPTH. Before g0005, do_dump recursively handled that depth without the new rejection.",
              "applicability": "required",
              "harness_status": "unsat",
              "reason": "The old harness obtains dump values only from json_loadb. The unchanged parser rejects values deeper than its limit, while dumping starts the root at depth zero; the harness constructs no deeper value.",
              "source_evidence": [
                {
                  "evidence_id": "loc-bf1b4607f4620d343f587f77",
                  "quote": "static int do_dump(const json_t *json, size_t flags, int depth, hashtable_t *parents,\n                   json_dump_callback_t dump, void *data) {\n    int embed = flags & JSON_EMBED;\n\n    flags &= ~JSON_EMBED;\n\n    if (!json)\n        return -1;\n\n    switch (json_typeof(json)) {\n"
                },
                {
                  "evidence_id": "loc-f02008f61fd138c8b6987881",
                  "quote": "        case JSON_ARRAY: {\n            size_t n;\n            size_t i;\n            /* Space for \"0x\", double the sizeof a pointer for the hex and a\n             * terminator. */\n            char key[2 + (sizeof(json) * 2) + 1];\n            size_t key_len;\n\n            /* detect circular references */\n            if (jsonp_loop_check(parents, json, key, sizeof(key), &key_len))\n                return -1;\n\n            n = json_array_size(json);\n\n            if (!embed && dump(\"[\", 1, data))\n                return -1;\n            if (n == 0) {\n                hashtable_del(parents, key, key_len);\n                return embed ? 0 : dump(\"]\", 1, data);\n            }\n            if (dump_indent(flags, depth + 1, 0, dump, data))\n                return -1;\n\n            for (i = 0; i < n - 1; ++i) {\n                if (do_dump(json_array_get(json, i), flags, depth + 1, parents, dump,\n                            data))\n                    return -1;\n\n                if (dump(\",\", 1, data) || dump_indent(flags, depth + 1, 1, dump, data))\n                    return -1;\n            }\n\n            if (do_dump(json_array_get(json, i), flags, depth + 1, parents, dump, data))\n                return -1;\n            if (dump_indent(flags, depth, 0, dump, data))\n                return -1;\n\n            hashtable_del(parents, key, key_len);\n            return embed ? 0 : dump(\"]\", 1, data);\n"
                },
                {
                  "evidence_id": "loc-f3a4218a0f0ec87b70775cf7",
                  "quote": "static json_t *parse_value(lex_t *lex, size_t flags, json_error_t *error) {\n    json_t *json;\n\n    lex->depth++;\n    if (lex->depth > JSON_PARSER_MAX_DEPTH) {\n        error_set(error, lex, json_error_stack_overflow, \"maximum parsing depth reached\");\n        return NULL;\n    }\n"
                },
                {
                  "evidence_id": "loc-018b1207f13beb1fda29be53",
                  "quote": "static json_t *parse_json(lex_t *lex, size_t flags, json_error_t *error) {\n    json_t *result;\n\n    lex->depth = 0;\n\n    lex_scan(lex, error);\n    if (!(flags & JSON_DECODE_ANY)) {\n        if (lex->token != '[' && lex->token != '{') {\n            error_set(error, lex, json_error_invalid_syntax, \"'[' or '{' expected\");\n            return NULL;\n        }\n    }\n\n    result = parse_value(lex, flags, error);\n    if (!result)\n"
                },
                {
                  "evidence_id": "loc-2a910779fc42a8a9bd71875f",
                  "quote": "int json_dump_callback(const json_t *json, json_dump_callback_t callback, void *data,\n                       size_t flags) {\n    int res;\n    hashtable_t parents_set;\n\n    if (!(flags & JSON_ENCODE_ANY)) {\n        if (!json_is_array(json) && !json_is_object(json))\n            return -1;\n    }\n\n    if (hashtable_init(&parents_set))\n        return -1;\n    res = do_dump(json, flags, 0, &parents_set, callback, data);\n    hashtable_close(&parents_set);\n\n    return res;\n}\n"
                }
              ]
            },
            "after": {
              "requirement": "Exercise the g0005 rejection when dumping a supported constructed value reaches depth JSON_PARSER_MAX_DEPTH.",
              "applicability": "required",
              "harness_status": "unsat",
              "reason": "The new guard is present, but the same unchanged parser limit prevents a successfully loaded value from reaching it. The harness still has no value-construction step.",
              "source_evidence": [
                {
                  "evidence_id": "loc-30540658bc45ec19d832ed45",
                  "quote": "static int do_dump(const json_t *json, size_t flags, int depth, hashtable_t *parents,\n                   json_dump_callback_t dump, void *data) {\n    int embed = flags & JSON_EMBED;\n\n    flags &= ~JSON_EMBED;\n\n    if (!json)\n        return -1;\n\n    if (depth >= JSON_PARSER_MAX_DEPTH)\n        return -1;\n\n    switch (json_typeof(json)) {\n"
                },
                {
                  "evidence_id": "loc-cf95ac94b433d80ca0a7bc9c",
                  "quote": "        case JSON_ARRAY: {\n            size_t n;\n            size_t i;\n            /* Space for \"0x\", double the sizeof a pointer for the hex and a\n             * terminator. */\n            char key[2 + (sizeof(json) * 2) + 1];\n            size_t key_len;\n\n            /* detect circular references */\n            if (jsonp_loop_check(parents, json, key, sizeof(key), &key_len))\n                return -1;\n\n            n = json_array_size(json);\n\n            if (!embed && dump(\"[\", 1, data))\n                return -1;\n            if (n == 0) {\n                hashtable_del(parents, key, key_len);\n                return embed ? 0 : dump(\"]\", 1, data);\n            }\n            if (dump_indent(flags, depth + 1, 0, dump, data))\n                return -1;\n\n            for (i = 0; i < n - 1; ++i) {\n                if (do_dump(json_array_get(json, i), flags, depth + 1, parents, dump,\n                            data))\n                    return -1;\n\n                if (dump(\",\", 1, data) || dump_indent(flags, depth + 1, 1, dump, data))\n                    return -1;\n            }\n\n            if (do_dump(json_array_get(json, i), flags, depth + 1, parents, dump, data))\n                return -1;\n            if (dump_indent(flags, depth, 0, dump, data))\n                return -1;\n\n            hashtable_del(parents, key, key_len);\n            return embed ? 0 : dump(\"]\", 1, data);\n"
                },
                {
                  "evidence_id": "loc-f49047133b89359256a673aa",
