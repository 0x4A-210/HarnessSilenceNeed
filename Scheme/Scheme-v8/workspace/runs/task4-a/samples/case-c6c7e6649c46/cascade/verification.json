  "candidates": [
    {
      "candidate_id": "c1",
      "source_id": "notes_uninitialized_before_assembly",
      "origin": "review-1",
      "kind": "lifecycle",
      "change_ids": [
        "g0006",
        "g0007"
      ],
      "requirement": "Initialize the notes obstack before the fuzz entry creates assembler sections.",
      "target_route": "LLVMFuzzerTestOneInput calls read_begin and then perform_an_assembly_pass. The pass creates .text through subseg_new, which reaches alloc_seginfo and obstack_alloc(&notes).",
      "failure_condition": "Initialization was moved from read_begin to main, which the fuzz entry does not call. Section metadata allocation therefore uses an uninitialized notes obstack before input parsing.",
      "alternative_paths": "subsegs_begin initializes section chains, not notes; read_begin no longer initializes notes. The target calls neither main nor another shown notes initializer before the pass.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
  "decisions": [
    {
      "candidate_id": "c1",
      "decision": "keep",
