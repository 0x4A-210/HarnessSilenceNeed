    "kind": "after_source",
    "path": "input/source/tinyxml2.cpp",
    "text": "XMLNode::~XMLNode()\r\n{\r\n    // Fast path: this node is dying, so maintaining _firstChild/_lastChild and\r\n    // sibling _prev/_next links is unnecessary. Only _parent must be zeroed to\r\n    // satisfy the MarkInUse assertion inside DeleteNode.\r\n    XMLNode *currentChild = _firstChild;\r\n    while (currentChild != NULL) {\r\n        XMLNode *next = currentChild->_next;\r\n        currentChild->_parent = 0;\r\n        DeleteNode(currentChild);\r\n        currentChild = next;\r\n    }\r\n\r\n    if ( _parent ) {\r\n        _parent->Unlink( this );\r\n    }\r\n}\r\n",
    "change_ids": [
      "g0001"
    ],
    "invariant_source": false,
    "citation_role": "primary",
    "dependency_reason": "",
    "location": {
      "unit_id": "u-45bd9f93d35daa1911b6",
      "version": "after",
      "path": "input/source/tinyxml2.cpp",
      "start_line": 835,
      "end_line": 851,
      "unit_sha256": "f8bf0012c37a7b3b9ecfdaf0001dd108077ef125bf69a558424eac923d407cef",
      "quote_sha256": "f8bf0012c37a7b3b9ecfdaf0001dd108077ef125bf69a558424eac923d407cef"
    }
