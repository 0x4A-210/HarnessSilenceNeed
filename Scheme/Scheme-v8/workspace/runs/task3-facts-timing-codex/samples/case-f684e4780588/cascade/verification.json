    "claims": [
      {
        "claim_id": "c1",
        "status": "introduced",
        "necessary": "yes",
        "before": {
          "requirement": "Rejection of explicit (?C) callouts through PCRE2_EXTRA_NEVER_CALLOUT with error 203 was not a supported behavior before this change.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The before-version extra-option mask lacks the bit, and its complete callout parser proceeds directly to parsing the callout without the new rejection guard.",
          "source_evidence": [
            {
              "evidence_id": "loc-e6accdabbd058e1b08a8aedc",
              "quote": "#define PUBLIC_COMPILE_EXTRA_OPTIONS \\\n   (PUBLIC_LITERAL_COMPILE_EXTRA_OPTIONS| \\\n    PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES|PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL| \\\n    PCRE2_EXTRA_ESCAPED_CR_IS_LF|PCRE2_EXTRA_ALT_BSUX| \\\n    PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK|PCRE2_EXTRA_ASCII_BSD| \\\n    PCRE2_EXTRA_ASCII_BSS|PCRE2_EXTRA_ASCII_BSW|PCRE2_EXTRA_ASCII_POSIX| \\\n    PCRE2_EXTRA_ASCII_DIGIT|PCRE2_EXTRA_PYTHON_OCTAL|PCRE2_EXTRA_NO_BS0)\n"
            },
            {
              "evidence_id": "loc-baf91b15bb29b42d0eef1fec",
              "quote": "      /* ---- Callout with numerical or string argument ---- */\n\n      case CHAR_C:\n      if (++ptr >= ptrend) goto UNCLOSED_PARENTHESIS;\n\n"
            },
            {
              "evidence_id": "loc-913cf071c7f906cf69d18312",
              "quote": "enum { ERR0 = COMPILE_ERROR_BASE,\n       ERR1,  ERR2,  ERR3,  ERR4,  ERR5,  ERR6,  ERR7,  ERR8,  ERR9,  ERR10,\n       ERR11, ERR12, ERR13, ERR14, ERR15, ERR16, ERR17, ERR18, ERR19, ERR20,\n       ERR21, ERR22, ERR23, ERR24, ERR25, ERR26, ERR27, ERR28, ERR29, ERR30,\n       ERR31, ERR32, ERR33, ERR34, ERR35, ERR36, ERR37, ERR38, ERR39, ERR40,\n       ERR41, ERR42, ERR43, ERR44, ERR45, ERR46, ERR47, ERR48, ERR49, ERR50,\n       ERR51, ERR52, ERR53, ERR54, ERR55, ERR56, ERR57, ERR58, ERR59, ERR60,\n       ERR61, ERR62, ERR63, ERR64, ERR65, ERR66, ERR67, ERR68, ERR69, ERR70,\n       ERR71, ERR72, ERR73, ERR74, ERR75, ERR76, ERR77, ERR78, ERR79, ERR80,\n       ERR81, ERR82, ERR83, ERR84, ERR85, ERR86, ERR87, ERR88, ERR89, ERR90,\n       ERR91, ERR92, ERR93, ERR94, ERR95, ERR96, ERR97, ERR98, ERR99, ERR100,\n       ERR101,ERR102 };\n"
            }
          ]
        },
        "after": {
          "requirement": "Compilation can select PCRE2_EXTRA_NEVER_CALLOUT and reject explicit (?C) callout syntax with error 203.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The after-version parser checks the new compile-context bit and returns ERR103. The fixed target only sets a compiled-length limit on that context, so generated input cannot enable this behavior.",
          "source_evidence": [
            {
              "evidence_id": "loc-dfd4178d248b932014badaa4",
              "quote": "<pre>\n  PCRE2_EXTRA_NEVER_CALLOUT\n</pre>\nIf this option is set, PCRE2 treats callouts in the pattern as a syntax error,\nreturning PCRE2_ERROR_CALLOUT_CALLER_DISABLED. This is useful if the application\nknows that a callout will not be provided to <b>pcre2_match()</b>, so that\ncallouts in the pattern are not silently ignored."
            },
            {
              "evidence_id": "loc-07b5dade74140bb3b76c5729",
              "quote": "#define PUBLIC_COMPILE_EXTRA_OPTIONS \\\n   (PUBLIC_LITERAL_COMPILE_EXTRA_OPTIONS| \\\n    PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES|PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL| \\\n    PCRE2_EXTRA_ESCAPED_CR_IS_LF|PCRE2_EXTRA_ALT_BSUX| \\\n    PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK|PCRE2_EXTRA_ASCII_BSD| \\\n    PCRE2_EXTRA_ASCII_BSS|PCRE2_EXTRA_ASCII_BSW|PCRE2_EXTRA_ASCII_POSIX| \\\n    PCRE2_EXTRA_ASCII_DIGIT|PCRE2_EXTRA_PYTHON_OCTAL|PCRE2_EXTRA_NO_BS0| \\\n    PCRE2_EXTRA_NEVER_CALLOUT)\n"
            },
            {
              "evidence_id": "loc-427344e56f2e1aa826375f1e",
              "quote": "uint32_t *parsed_pattern = cb->parsed_pattern;\nuint32_t *parsed_pattern_end = cb->parsed_pattern_end;\nuint32_t *this_parsed_item = NULL;\nuint32_t *prev_parsed_item = NULL;\nuint32_t meta_quantifier = 0;\nuint32_t add_after_mark = 0;\nuint32_t xoptions = cb->cx->extra_options;\n"
            },
            {
              "evidence_id": "loc-91785a8f7b5cbb14f692923a",
              "quote": "      /* ---- Callout with numerical or string argument ---- */\n\n      case CHAR_C:\n      if ((xoptions & PCRE2_EXTRA_NEVER_CALLOUT) != 0)\n        {\n        errorcode = ERR103;\n        goto FAILED;\n        }\n"
            },
            {
              "evidence_id": "loc-92ff3a44007692b5d62bbac7",
              "quote": "enum { ERR0 = COMPILE_ERROR_BASE,\n       ERR1,  ERR2,  ERR3,  ERR4,  ERR5,  ERR6,  ERR7,  ERR8,  ERR9,  ERR10,\n       ERR11, ERR12, ERR13, ERR14, ERR15, ERR16, ERR17, ERR18, ERR19, ERR20,\n       ERR21, ERR22, ERR23, ERR24, ERR25, ERR26, ERR27, ERR28, ERR29, ERR30,\n       ERR31, ERR32, ERR33, ERR34, ERR35, ERR36, ERR37, ERR38, ERR39, ERR40,\n       ERR41, ERR42, ERR43, ERR44, ERR45, ERR46, ERR47, ERR48, ERR49, ERR50,\n       ERR51, ERR52, ERR53, ERR54, ERR55, ERR56, ERR57, ERR58, ERR59, ERR60,\n       ERR61, ERR62, ERR63, ERR64, ERR65, ERR66, ERR67, ERR68, ERR69, ERR70,\n       ERR71, ERR72, ERR73, ERR74, ERR75, ERR76, ERR77, ERR78, ERR79, ERR80,\n       ERR81, ERR82, ERR83, ERR84, ERR85, ERR86, ERR87, ERR88, ERR89, ERR90,\n       ERR91, ERR92, ERR93, ERR94, ERR95, ERR96, ERR97, ERR98, ERR99, ERR100,\n       ERR101,ERR102,ERR103 };\n"
            }
          ]
        },
        "same_blocker": "not_applicable",
        "reason": "The same option-controlled rejection tuple is absent before and required but unreachable afterward. Ordinary callout compilation before the change is a different behavior.",
