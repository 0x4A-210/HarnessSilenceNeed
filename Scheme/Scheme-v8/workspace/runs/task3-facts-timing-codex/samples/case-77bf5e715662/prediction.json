          ]
        }
      ],
      "scope_complete": false,
      "timing": {
        "status": "introduced",
        "gap": true,
        "introduced_by_this_change": true,
        "claims": [
          {
            "claim_id": "c1",
            "status": "introduced",
            "necessary": "yes",
            "before": {
              "requirement": "Explicitly supply all 16 hash-salt bytes, including a nonzero first key half, before parsing.",
              "applicability": "not_applicable",
              "harness_status": "not_applicable",
              "reason": "The before source stores only an unsigned-long salt and copies zero into the first SipHash key half. The reconstructed preimage has no XML_SetHashSalt16Bytes definition in xmlparse.c.",
              "source_evidence": [
                {
                  "evidence_id": "loc-ad40a484c6a14836e301a974",
                  "quote": "int XMLCALL\nXML_SetHashSalt(XML_Parser parser, unsigned long hash_salt) {\n  if (parser == NULL)\n    return 0;\n\n  const XML_Parser rootParser = getRootParserOf(parser, NULL);\n  assert(! rootParser->m_parentParser);\n\n  /* block after XML_Parse()/XML_ParseBuffer() has been called */\n  if (parserBusy(rootParser))\n    return 0;\n  rootParser->m_hash_secret_salt = hash_salt;\n  return 1;\n}\n"
                },
                {
                  "evidence_id": "loc-da434ff2a71213c10a767b33",
                  "quote": "  unsigned long m_hash_secret_salt;\n"
                },
                {
                  "evidence_id": "loc-dfcfb249b1e797e7cb3aeecc",
                  "quote": "static void\ncopy_salt_to_sipkey(XML_Parser parser, struct sipkey *key) {\n  key->k[0] = 0;\n  key->k[1] = get_hash_secret_salt(parser);\n}\n"
                },
                {
                  "evidence_id": "loc-9f13ce85f2af367763abe092",
                  "quote": "Verified preimage file expat/lib/xmlparse.c has no function definition named XML_SetHashSalt16Bytes. The entire after definition consists of added lines. This establishes absence in this file only; other implementations or equivalent paths must still be considered."
                }
              ]
            },
            "after": {
              "requirement": "Explicitly supply all 16 hash-salt bytes, including a nonzero first key half, to a fresh parser before parsing.",
              "applicability": "required",
              "harness_status": "unsat",
              "reason": "The new public setter copies caller-supplied 16-byte entropy before parsing. The old harness calls only XML_SetHashSalt, whose after implementation fixes the first key half to zero.",
              "source_evidence": [
                {
                  "evidence_id": "loc-dbe90814bfba620244b14c63",
                  "quote": "XML_Bool XMLCALL\nXML_SetHashSalt16Bytes(XML_Parser parser, const uint8_t entropy[16]) {\n  if (parser == NULL)\n    return XML_FALSE;\n\n  if (entropy == NULL)\n    return XML_FALSE;\n\n  const XML_Parser rootParser = getRootParserOf(parser, NULL);\n  assert(! rootParser->m_parentParser);\n\n  /* block after XML_Parse()/XML_ParseBuffer() has been called */\n  if (parserBusy(rootParser))\n    return XML_FALSE;\n\n  sip_tokey(&(rootParser->m_hash_secret_salt_128), entropy);\n\n  rootParser->m_hash_secret_salt_set = XML_TRUE;\n\n  ENTROPY_DEBUG(\"explicit(16)\", rootParser->m_hash_secret_salt_128);\n\n  return XML_TRUE;\n}\n"
                },
                {
                  "evidence_id": "loc-937b74d90412b3142bcf3bbd",
                  "quote": "XMLPARSEAPI(XML_Bool)\nXML_SetHashSalt16Bytes(XML_Parser parser, const uint8_t entropy[16]);\n"
                },
                {
                  "evidence_id": "loc-1b7272df005ae369a6b15f22",
                  "quote": "  rootParser->m_hash_secret_salt_128.k[0] = 0;\n  rootParser->m_hash_secret_salt_128.k[1] = hash_salt;\n\n  if (hash_salt != 0) { // to remain backwards compatible\n    rootParser->m_hash_secret_salt_set = XML_TRUE;\n\n    if (sizeof(unsigned long) == 4)\n      ENTROPY_DEBUG(\"explicit(4)\", rootParser->m_hash_secret_salt_128);\n    else\n      ENTROPY_DEBUG(\"explicit(8)\", rootParser->m_hash_secret_salt_128);\n  }\n"
                }
              ]
            },
            "same_blocker": "not_applicable",
            "reason": "The tuple is the same explicit 16-byte pre-parse operation on both sides. It was unsupported before and is supported but unreachable through the fixed harness after; the prior unsigned-long limitation is not labeled a preexisting blocker for a capability that did not yet exist.",
            "error": null,
            "missing_information": []
          }
