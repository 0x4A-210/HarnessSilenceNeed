          ],
          "requirement": "Advertise local SETTINGS_NO_RFC7540_PRIORITIES=1 so received request Priority fields can set extensible priority and apply it to the stream.",
          "target_route": "A valid client preface, SETTINGS, and HPACK-encoded request HEADERS containing a valid Priority field enter mem_recv, header inflation, http_request_on_header, and session_end_stream_headers_received.",
          "failure_condition": "The harness submits only MAX_CONCURRENT_STREAMS, leaving pending_no_rfc7540_priorities at 0. Opened request streams lack NO_RFC7540_PRIORITIES, so the Priority field cannot set the new flag or apply its parsed value.",
          "alternative_paths": "A peer SETTINGS_NO_RFC7540_PRIORITIES value changes remote settings only. Neither natural request bytes nor the harness’s other calls submit the required local setting; the legacy PRIORITY frame does not apply the request Priority field contract.",
          "discovery_necessary": true,
          "discovery_established": true
        }
