          "citation_errors": [],
          "cited_paths": [
            "input/harness/oss-fuzz/libyaml_scanner_fuzzer.c",
            "input/source/include/yaml.h",
            "input/source/src/parser.c",
            "input/source/src/scanner.c"
          ]
        }
      ],
      "scope_complete": false,
      "timing": {
        "status": "introduced",
        "gap": true,
        "introduced_by_this_change": true,
        "claims": [
          {
            "claim_id": "c1",
            "status": "introduced",
            "necessary": "yes",
            "before": {
              "requirement": "Reach scanning of a balanced depth-1001 flow collection. The scanner does not consult the configurable maximum when increasing flow depth.",
              "applicability": "required",
              "harness_status": "sat",
              "reason": "The old increase function rejects only INT_MAX. The fixed harness forwards the finite input and continues scanning, so its default setup is an equivalent route to this scanning capability.",
              "source_evidence": [
                {
                  "evidence_id": "loc-ec042bd7ebddafb0f4304310",
                  "quote": "static int\nyaml_parser_increase_flow_level(yaml_parser_t *parser)\n{\n    yaml_simple_key_t empty_simple_key = { 0, 0, 0, { 0, 0, 0 } };\n\n    /* Reset the simple key on the next level. */\n\n    if (!PUSH(parser, parser->simple_keys, empty_simple_key))\n        return 0;\n\n    /* Increase the flow level. */\n\n    if (parser->flow_level == INT_MAX) {\n        parser->error = YAML_MEMORY_ERROR;\n        return 0;\n    }\n\n    parser->flow_level++;\n\n    return 1;\n}\n"
                },
                {
                  "evidence_id": "loc-aeca9f4969f438e866bdafd1",
                  "quote": "    /* Is it the flow sequence start indicator? */\n\n    if (CHECK(parser->buffer, '['))\n        return yaml_parser_fetch_flow_collection_start(parser,\n                YAML_FLOW_SEQUENCE_START_TOKEN);\n\n    /* Is it the flow mapping start indicator? */\n\n    if (CHECK(parser->buffer, '{'))\n        return yaml_parser_fetch_flow_collection_start(parser,\n                YAML_FLOW_MAPPING_START_TOKEN);\n"
                },
                {
                  "evidence_id": "loc-647f2ca80c863470b6973cc0",
                  "quote": "    /* The indicators '[' and '{' may start a simple key. */\n\n    if (!yaml_parser_save_simple_key(parser))\n        return 0;\n\n    /* Increase the flow level. */\n\n    if (!yaml_parser_increase_flow_level(parser))\n        return 0;\n\n    /* A simple key may follow the indicators '[' and '{'. */\n\n    parser->simple_key_allowed = 1;\n\n    /* Consume the token. */\n\n    start_mark = parser->mark;\n    SKIP(parser);\n    end_mark = parser->mark;\n\n    /* Create the FLOW-SEQUENCE-START of FLOW-MAPPING-START token. */\n\n    TOKEN_INIT(token, type, start_mark, end_mark);\n\n    /* Append the token to the queue. */\n\n    if (!ENQUEUE(parser, parser->tokens, token))\n        return 0;\n\n    return 1;\n"
                }
              ]
            },
            "after": {
              "requirement": "Reach scanning of the same balanced depth-1001 flow collection under a supported limit above 1000, such as 2000.",
              "applicability": "required",
              "harness_status": "unsat",
              "reason": "The new guard rejects the 1001st opening bracket at the default limit of 1000. The old harness has no setter call, so input bytes cannot reach the supported higher-limit setup.",
              "source_evidence": [
                {
                  "evidence_id": "loc-98b270da28ffc9d55360d6e3",
                  "quote": "    /* Increase the flow level. */\n\n    if (parser->flow_level == INT_MAX) {\n        parser->error = YAML_MEMORY_ERROR;\n        return 0;\n    }\n\n    if (parser->flow_level >= MAX_NESTING_LEVEL) {\n        return yaml_parser_set_scanner_error(parser,\n                \"while increasing flow level\", parser->mark,\n                \"exceeded maximum nesting depth\");\n    }\n\n    parser->flow_level++;\n\n    return 1;\n"
                },
                {
                  "evidence_id": "loc-b7ff87ede3ef1c60ecb7d22f",
                  "quote": "int MAX_NESTING_LEVEL = 1000;\n"
                },
                {
                  "evidence_id": "loc-65a3ef9cdd45db640e904016",
                  "quote": "YAML_DECLARE(void)\nyaml_set_max_nest_level(int max)\n{\n    MAX_NESTING_LEVEL = max;\n}\n"
                },
                {
                  "evidence_id": "loc-593d4e40bb06c0a602575498",
                  "quote": "/**\n * Set the maximum depth of nesting.\n *\n * Default: 1000\n *\n * Each nesting level increases the stack and the number of previous\n * starting events that the parser has to check.\n *\n * @param[in]       max         The maximum number of allowed nested events\n */\n\nYAML_DECLARE(void)\nyaml_set_max_nest_level(int max);\n"
                }
              ]
            },
            "same_blocker": "no",
            "reason": "The tuple remains scanner scan, balanced depth-1001 flow input, the capability to scan it, and its reachability. Before, the old scanner has no nesting-limit guard; after, the new guard makes the target's fixed default setup block that capability.",
            "error": null,
            "missing_information": []
          }
        ],
