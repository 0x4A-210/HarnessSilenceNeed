                  "quote": "void\nxmlXIncludeSetErrorHandler(xmlXIncludeCtxtPtr ctxt,\n                           xmlStructuredErrorFunc handler, void *data) {\n    if (ctxt == NULL)\n        return;\n    ctxt->errorHandler = handler;\n    ctxt->errorCtxt = data;\n}\n"
