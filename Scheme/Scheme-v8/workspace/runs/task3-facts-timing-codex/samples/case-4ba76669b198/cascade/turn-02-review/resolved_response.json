    {
      "id": "xinclude-memory-error-assertion",
      "change_ids": [
        "g0003",
        "g0007"
      ],
      "kind": "check",
      "necessary": true,
      "established": true,
      "requirement": "An injected allocation failure during XInclude processing must satisfy the target's existing check that xmlXIncludeGetLastError reports XML_ERR_NO_MEMORY.",
      "target_route": "A valid main document containing a nonlocal xi:include reaches ProcessNode, DoProcess, ExpandNode, AddNode, and NewRef. Set the input's allocation limit to the allocation number of NewRef's xmlMalloc; pad an unused entity so the modulo permits that finite limit.",
      "failure_condition": "NewRef's xmlMalloc returns NULL and marks fuzzAllocFailed. The replacement xmlXIncludeErrMemory updates a global error but does not set the XInclude context's errNo. NewRef returns NULL; the target's existing allocation-failure check then aborts.",
      "alternative_paths": "The failed reference is never loaded, so the fallback/error path in LoadNode cannot set this context's errNo. ResetMallocFailed clears only the failure flag before processing, and the target reads the context error number rather than the global error.",
      "source_evidence": [
        {
          "unit_id": "u-b954120108bc446b7b7b",
          "start_line": 2,
          "end_line": 4,
          "role": "primary",
          "dependency_reason": ""
        },
        {
          "unit_id": "u-b0320090c18d78bc9cdd",
          "start_line": 228,
          "end_line": 246,
          "role": "primary",
          "dependency_reason": ""
        },
        {
          "unit_id": "u-9d1440d928933687bede",
          "start_line": 584,
          "end_line": 609,
          "role": "dependency",
          "dependency_reason": "The delegated reporter writes global or optional error structures; the XInclude helper passes no optional context error structure."
        },
        {
          "unit_id": "u-eb0dea047605b0a834d0",
          "start_line": 1958,
          "end_line": 1968,
          "role": "dependency",
          "dependency_reason": "A failed AddNode returns before LoadNode can report another error."
        },
        {
          "unit_id": "u-abc2c8ff8bf071643919",
          "start_line": 2254,
          "end_line": 2280,
          "role": "dependency",
          "dependency_reason": "Document traversal tests and expands xi:include nodes."
        },
        {
