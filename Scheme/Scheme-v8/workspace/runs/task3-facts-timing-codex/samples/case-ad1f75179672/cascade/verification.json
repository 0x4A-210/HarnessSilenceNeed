  "scope_complete": false,
  "timing": {
    "status": "introduced",
    "gap": true,
    "introduced_by_this_change": true,
    "claims": [
      {
        "claim_id": "c1",
        "status": "introduced",
        "necessary": "yes",
        "before": {
          "requirement": "The same tuple would require a direct COMPOSE call to preserve 0x110000 and prevent composition across it.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The before implementation skipped the out-of-range element and retained composition state, so it did not support this tuple.",
          "source_evidence": [
            {
              "evidence_id": "loc-01682d0a6d391146d7697a37",
              "quote": "  if (options & UTF8PROC_COMPOSE) {\n    utf8proc_int32_t *starter = NULL;\n    const utf8proc_property_t *starter_property = NULL;\n    utf8proc_propval_t max_combining_class = -1;\n    utf8proc_ssize_t rpos;\n    utf8proc_ssize_t wpos = 0;\n    for (rpos = 0; rpos < length; rpos++) {\n      utf8proc_int32_t current_char = buffer[rpos];\n      if (current_char < 0 || current_char >= 0x110000) {\n        /* skip grapheme-break sentinel or out-of-range codepoint;\n           unsafe_get_property would OOB on utf8proc_stage1table (idx = uc >> 8) */\n        continue;\n      }\n      const utf8proc_property_t *current_property = unsafe_get_property(current_char);\n"
            },
            {
              "evidence_id": "loc-874bab6aa95d50126d1f3960",
              "quote": "- `utf8proc_normalize_utf32` can now handle invalid codepoints ≥ 0x110000 ([#352])."
            }
          ]
        },
        "after": {
          "requirement": "Reach a nonempty direct UTF-32 COMPOSE call containing 0x110000, preserving it and preventing composition across it.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The after implementation supports the tuple. The fixed harness skips direct calls for sizes of at least four and otherwise passes length zero; none of those calls selects COMPOSE.",
          "source_evidence": [
            {
              "evidence_id": "loc-668820b9eb50a31203921dbb",
              "quote": "  if (options & UTF8PROC_COMPOSE) {\n    utf8proc_int32_t *starter = NULL;\n    const utf8proc_property_t *starter_property = NULL;\n    utf8proc_propval_t max_combining_class = -1;\n    utf8proc_ssize_t rpos;\n    utf8proc_ssize_t wpos = 0;\n    for (rpos = 0; rpos < length; rpos++) {\n      utf8proc_int32_t current_char = buffer[rpos];\n      if (current_char < 0 || current_char >= 0x110000) {\n        /* grapheme-break sentinel or out-of-range codepoint: pass it through\n           unchanged, but never compose across it, since we cannot inspect it\n           (unsafe_get_property would OOB on utf8proc_stage1table, idx = uc >> 8).\n           utf8proc_reencode drops what cannot be encoded, so this is invisible\n           to utf8proc_map. */\n        buffer[wpos++] = current_char;\n        starter = NULL;\n        starter_property = NULL;\n        max_combining_class = -1;\n        continue;\n      }\n"
            },
            {
              "evidence_id": "loc-c4cc867dc2ee7081981c520c",
              "quote": "    /* an out-of-range codepoint is preserved, and blocks composition across it\n       (unsafe_get_property would read past utf8proc_stage1table) */\n    {\n        utf8proc_int32_t input[] = {0x0041, 0x110000, 0x0301};\n        check_normalize_utf32(\"out-of-range codepoint\", input, 3, input, 3);\n    }\n\n    /* likewise the grapheme-break sentinel written by utf8proc_decompose_char */\n    {\n        utf8proc_int32_t input[] = {0x0041, -1, 0x0301};\n        check_normalize_utf32(\"grapheme-break sentinel\", input, 3, input, 3);\n"
            }
          ]
        },
        "same_blocker": "not_applicable",
        "reason": "The direct-call constraint is unchanged, but before source did not support c1's preservation capability. The same tuple therefore becomes required only after the change.",
        "error": null,
        "missing_information": []
      }
    ],
