      ],
      "requirement": "For the direct utf8proc_normalize_utf32 operation, reach a nonempty UTF-32 buffer containing an out-of-range element with UTF8PROC_COMPOSE, so preservation and the composition boundary can be exercised.",
      "target_route": "LLVMFuzzerTestOneInput allocates copy, copies input into it, then invokes utf8proc_normalize_utf32 with selected options.",
      "failure_condition": "If input size is at least four, copy is NULL and the calls are skipped. Otherwise size is divided by four, so every call has length zero. None of their options includes UTF8PROC_COMPOSE.",
      "alternative_paths": "The other entry calls operate on decoded codepoints or UTF-8 byte strings. utf8proc_iterate rejects encodings above U+10FFFF, and these calls do not expose the direct UTF-32 buffer behavior with 0x110000.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
  "decisions": [
