  "text": "        int close() {\n            if (m_os) {\n                ::gzwrite(m_fp, m_os->str(), m_os->pcount());\n                delete[] m_os->str(); delete m_os; m_os = 0;\n            }\n            int r = ::gzclose(m_fp); m_fp = 0; return r;\n        }\n",
