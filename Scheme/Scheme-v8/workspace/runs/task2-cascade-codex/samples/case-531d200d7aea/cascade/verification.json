          "requirement": "Continue from a successful copy of a parsed event to yaml_emitter_emit.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "Before the change, the parser produced a stream start event. Copying it returns 1, which sends the fixed harness to cleanup before emission.",
          "source_evidence": [
            {
              "evidence_id": "loc-065740dbff1ddb570f111edf",
              "quote": "static int\nyaml_parser_state_machine(yaml_parser_t *parser, yaml_event_t *event)\n{\n    switch (parser->state)\n    {\n        case YAML_PARSE_STREAM_START_STATE:\n            return yaml_parser_parse_stream_start(parser, event);\n\n"
            },
            {
              "evidence_id": "loc-c3eeb0391ea53867224e93f1",
              "quote": "static int\nyaml_parser_parse_stream_start(yaml_parser_t *parser, yaml_event_t *event)\n{\n    yaml_token_t *token;\n\n    token = PEEK_TOKEN(parser);\n    if (!token) return 0;\n\n    if (token->type != YAML_STREAM_START_TOKEN) {\n        return yaml_parser_set_parser_error(parser,\n                \"did not find expected <stream-start>\", token->start_mark);\n    }\n\n    parser->state = YAML_PARSE_IMPLICIT_DOCUMENT_START_STATE;\n    STREAM_START_EVENT_INIT(*event, token->data.stream_start.encoding,\n            token->start_mark, token->start_mark);\n    SKIP_TOKEN(parser);\n\n    return 1;\n"
            },
            {
              "evidence_id": "loc-af0085f93592589878be7ad4",
              "quote": "static int\nyaml_parser_parse_flow_sequence_entry_mapping_key(yaml_parser_t *parser,\n        yaml_event_t *event)\n{\n    yaml_token_t *token;\n\n    token = PEEK_TOKEN(parser);\n    if (!token) return 0;\n\n    if (token->type != YAML_VALUE_TOKEN && token->type != YAML_FLOW_ENTRY_TOKEN\n            && token->type != YAML_FLOW_SEQUENCE_END_TOKEN) {\n        if (!PUSH(parser, parser->states,\n                    YAML_PARSE_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE_STATE))\n            return 0;\n        return yaml_parser_parse_node(parser, event, 0, 0);\n    }\n    else {\n        yaml_mark_t mark = token->end_mark;\n        SKIP_TOKEN(parser);\n        parser->state = YAML_PARSE_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE_STATE;\n        return yaml_parser_process_empty_scalar(parser, event, mark);\n    }\n}\n"
            }
          ]
        },
        "after": {
          "requirement": "Continue from a successful copy of a parsed event to yaml_emitter_emit, including events from the changed flow sequence state.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The added branch changes a later parser event, but the same successful stream start copy still sends the fixed harness to cleanup first.",
          "source_evidence": [
            {
              "evidence_id": "loc-5581f75bdbfff9ee14d9964b",
              "quote": "static int\nyaml_parser_state_machine(yaml_parser_t *parser, yaml_event_t *event)\n{\n    switch (parser->state)\n    {\n        case YAML_PARSE_STREAM_START_STATE:\n            return yaml_parser_parse_stream_start(parser, event);\n\n"
            },
            {
              "evidence_id": "loc-d128312e4415094c3abeb289",
              "quote": "static int\nyaml_parser_parse_stream_start(yaml_parser_t *parser, yaml_event_t *event)\n{\n    yaml_token_t *token;\n\n    token = PEEK_TOKEN(parser);\n    if (!token) return 0;\n\n    if (token->type != YAML_STREAM_START_TOKEN) {\n        return yaml_parser_set_parser_error(parser,\n                \"did not find expected <stream-start>\", token->start_mark);\n    }\n\n    parser->state = YAML_PARSE_IMPLICIT_DOCUMENT_START_STATE;\n    STREAM_START_EVENT_INIT(*event, token->data.stream_start.encoding,\n            token->start_mark, token->start_mark);\n    SKIP_TOKEN(parser);\n\n    return 1;\n"
            },
            {
              "evidence_id": "loc-cddaa6257347a06bb6f782a9",
              "quote": "    else if (token->type == YAML_FLOW_SEQUENCE_END_TOKEN) {\n        parser->state = POP(parser, parser->states);\n        (void)POP(parser, parser->marks);\n        SEQUENCE_END_EVENT_INIT(*event, token->start_mark, token->end_mark);\n        SKIP_TOKEN(parser);\n        return 1;\n    }\n"
            }
          ]
        },
