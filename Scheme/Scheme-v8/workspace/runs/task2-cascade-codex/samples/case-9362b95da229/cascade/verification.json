        "before": {
          "requirement": "Pass a 32-element operator array to crc32_combine_gen(op, length), then pass that array to crc32_combine_op.",
          "applicability": "required",
          "harness_status": "sat",
          "reason": "The old declaration and implementation accept the harness's array and two-argument generator calls.",
          "source_evidence": [
            {
              "evidence_id": "loc-89c91b53dc675dcff0b52078",
              "quote": "ZEXTERN void ZEXPORT crc32_combine_gen OF((z_crc_t op[32], z_off_t len2));\n     Generate the operator op corresponding to length len2, to be used with\n   crc32_combine_op(). op must have room for 32 z_crc_t values. (32 is the\n   number of bits in the CRC.)\nZEXTERN uLong ZEXPORT crc32_combine_op OF((uLong crc1, uLong crc2,\n                                           const z_crc_t *op));\n"
            },
            {
              "evidence_id": "loc-aef8e4e79fc7f07aeda479ca",
              "quote": "void ZEXPORT crc32_combine_gen(op, len2)\n    z_crc_t *op;\n    z_off_t len2;\n{\n    crc32_combine_gen_(op, len2);\n}\n"
            }
          ]
        },
        "after": {
          "requirement": "Call crc32_combine_gen(length), retain its scalar return value, and pass that scalar to crc32_combine_op.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "Both harness generator calls still supply two arguments to the new one-argument declaration; its operator remains an array rather than the required scalar.",
          "source_evidence": [
            {
              "evidence_id": "loc-8c10a0d35e8413a0c91a1e02",
              "quote": "ZEXTERN uLong ZEXPORT crc32_combine_gen OF((z_off_t len2));\n     Return the operator corresponding to length len2, to be used with\n   crc32_combine_op().\nZEXTERN uLong ZEXPORT crc32_combine_op OF((uLong crc1, uLong crc2, uLong op));\n"
            },
            {
              "evidence_id": "loc-ad8018b87c713054df943830",
              "quote": "uLong ZEXPORT crc32_combine_gen(len2)\n    z_off_t len2;\n{\n    return crc32_combine_gen64(len2);\n}\n"
            },
            {
              "evidence_id": "loc-bb915767680c74774d79131a",
              "quote": "uLong crc32_combine_op(crc1, crc2, op)\n    uLong crc1;\n    uLong crc2;\n    uLong op;\n{\n    return multmodp(op, crc1) ^ crc2;\n}\n"
            }
          ]
        },
        "same_blocker": "no",
        "reason": "The same old harness is compatible with the previous matrix-operator API and incompatible with the changed scalar-operator API.",
        "error": null,
