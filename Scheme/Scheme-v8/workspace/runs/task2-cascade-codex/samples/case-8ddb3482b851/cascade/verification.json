      "origin": "review-1",
      "kind": "lifecycle",
      "change_ids": [],
      "requirement": "A later fuzz invocation with valid audio input must be able to reach encoding after an earlier invocation requested the version.",
      "target_route": "A first input supplies -v; parse_option sets show_version. A second input supplies a valid WAVE file without -v. The entry resets getopt state, but init_options does not reset show_version, so do_it returns before encode_file.",
      "failure_condition": "After the first invocation, every later invocation in the same process takes the version return, leaving supported encoding unreachable.",
      "alternative_paths": "The complete init_options and free_options bodies do not clear show_version; the complete option parser only sets it. No input option restores the encoding route.",
      "discovery_necessary": true,
      "discovery_established": true
    }
