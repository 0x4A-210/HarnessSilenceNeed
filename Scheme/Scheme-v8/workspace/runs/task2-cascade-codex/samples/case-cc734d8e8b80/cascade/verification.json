      ],
      "requirement": "The scanner target must be able to scan flow collections using a supported nesting limit above the default 1000.",
      "target_route": "Call yaml_set_max_nest_level(2000), then scan a balanced flow sequence of 1500 '[' bytes followed by 1500 ']' bytes.",
      "failure_condition": "The old target never changes the limit. At its default of 1000, the scanner rejects the 1001st opening bracket and the target exits the scan loop.",
      "alternative_paths": "Changing input bytes cannot change MAX_NESTING_LEVEL. The target has one scan sequence and no setter call; reaching the same guard at the default threshold does not exercise acceptance under the supported higher limit.",
      "discovery_necessary": true,
      "discovery_established": true
    }
