    "claims": [
      {
        "claim_id": "c1",
        "status": "introduced",
        "necessary": "yes",
        "before": {
          "requirement": "A string type mismatch reports the actual type; this version has no keyed string wrong-type diagnostic.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The same key-aware diagnostic tuple was unsupported: object fields passed no key to `unpack`, and string mismatch text contained only the type.",
          "source_evidence": [
            {
              "evidence_id": "loc-f4ede11a01a9770ce5de3a16",
              "quote": "        case 's':\n            if (root && !json_is_string(root)) {\n                set_error(s, \"<validation>\", json_error_wrong_type,\n                          \"Expected string, got %s\", type_name(root));\n                return -1;\n"
            },
            {
              "evidence_id": "loc-8d8e15f50bb0387956a19bd2",
              "quote": "        key = va_arg(*ap, const char *);\n        if (!key) {\n            set_error(s, \"<args>\", json_error_null_value, \"NULL object key\");\n            goto out;\n        }\n        key_len = strlen(key);\n\n        next_token(s);\n\n        if (token(s) == '?') {\n            opt = gotopt = 1;\n            next_token(s);\n        }\n\n        if (!root) {\n            /* skipping */\n            value = NULL;\n        } else {\n            value = json_object_getn(root, key, key_len);\n            if (!value && !opt) {\n                set_error(s, \"<validation>\", json_error_item_not_found,\n                          \"Object item not found: %s\", key);\n                goto out;\n            }\n        }\n\n        if (unpack(s, value, ap))\n            goto out;\n"
            }
          ]
        },
        "after": {
          "requirement": "A mismatched string value in an object field can report its field key in the wrong-type diagnostic.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The object-field key reaches string validation, but the old target's fixed object formats select `o` and its `json_unpack` calls provide no error output.",
          "source_evidence": [
            {
              "evidence_id": "loc-01343e30a8e633f554b66053",
              "quote": "        case 's':\n            if (root && !json_is_string(root)) {\n                set_error(s, \"<validation>\", json_error_wrong_type,\n                          \"Expected string, got %s%s%s\", type_name(root),\n                          key ? \" for key \" : \"\", key ? key : \"\");\n                return -1;\n"
            },
            {
              "evidence_id": "loc-c75c07a43e00ae15c5b21631",
              "quote": "        key = va_arg(*ap, const char *);\n        if (!key) {\n            set_error(s, \"<args>\", json_error_null_value, \"NULL object key\");\n            goto out;\n        }\n        key_len = strlen(key);\n\n        next_token(s);\n\n        if (token(s) == '?') {\n            opt = gotopt = 1;\n            next_token(s);\n        }\n\n        if (!root) {\n            /* skipping */\n            value = NULL;\n        } else {\n            value = json_object_getn(root, key, key_len);\n            if (!value && !opt) {\n                set_error(s, \"<validation>\", json_error_item_not_found,\n                          \"Object item not found: %s\", key);\n                goto out;\n            }\n        }\n\n        if (unpack(s, value, ap, key))\n            goto out;\n"
            },
            {
              "evidence_id": "loc-d60f27ec0eb42d611672247f",
              "quote": "int json_unpack(json_t *root, const char *fmt, ...) {\n    int ret;\n    va_list ap;\n\n    va_start(ap, fmt);\n    ret = json_vunpack_ex(root, NULL, 0, fmt, ap);\n    va_end(ap);\n\n    return ret;\n"
            }
          ]
        },
        "same_blocker": "not_applicable",
        "reason": "The old target's fixed format and missing error output are unchanged, but the specific keyed diagnostic obligation did not exist before. An older inability to exercise plain string mismatches is a different tuple.",
        "error": null,
        "missing_information": []
      }
