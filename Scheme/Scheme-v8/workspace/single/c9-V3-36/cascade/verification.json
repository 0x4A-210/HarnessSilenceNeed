{
  "verdict": "needs_update",
  "status": "introduced",
  "candidates": [
    {
      "candidate_id": "c1",
      "source_id": "reparse-deferral-skip",
      "origin": "discover",
      "kind": "call",
      "change_ids": [
        "g0016"
      ],
      "requirement": "Exercise reparse deferral on a nonfinal call after a prior nonfinal call leaves a partial token, with the pending byte count still below the retry threshold and sufficient buffer space.",
      "target_route": "LLVMFuzzerTestOneInput creates a parser; ParseOneInput makes one nonfinal XML_Parse with the entire fuzz input, then repeats the same bytes with isFinal=1.",
      "failure_condition": "On the first call m_partialTokenBytesBefore starts at zero, so the retry condition succeeds. On the second call finalBuffer is true, so the new skip decision is bypassed. No generated byte sequence can supply the required intermediate nonfinal call.",
      "alternative_paths": "The namespace and external-entity parsers repeat the same two-call pattern. The optional reset occurs after both calls, and this target never calls XML_ParseBuffer or XML_ResumeParser directly.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
  "decisions": [
    {
      "candidate_id": "c1",
      "decision": "keep",
      "errors": [],
      "obligation_class": "target_coverage",
      "citation_errors": [],
      "cited_paths": [
        "expat/lib/xmlparse.c",
        "input/harness/build/build.sh",
        "input/harness/expat/fuzz/xml_parse_fuzzer.c",
        "input/source/expat/CMakeLists.txt",
        "input/source/expat/lib/xmlparse.c"
      ]
    }
  ],
  "scope_complete": false,
  "timing": {
    "status": "introduced",
    "gap": true,
    "introduced_by_this_change": true,
    "claims": [
      {
        "claim_id": "c1",
        "status": "introduced",
        "necessary": "yes",
        "before": {
          "requirement": "Exercise a reparse-deferral skip after a partial token.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The prechange XML_ParseBuffer calls m_processor directly. The reparse-deferral skip decision did not exist.",
          "source_evidence": [
            {
              "evidence_id": "loc-15d78c81d2e35aafca4af218",
              "quote": "Verified preimage file expat/lib/xmlparse.c has no function definition named callProcessor. The entire after definition consists of added lines. This establishes absence in this file only; other implementations or equivalent paths must still be considered."
            },
            {
              "evidence_id": "loc-0ea44bcbb169fc2b9692be8e",
              "quote": "  start = parser->m_bufferPtr;\n  parser->m_positionPtr = start;\n  parser->m_bufferEnd += len;\n  parser->m_parseEndPtr = parser->m_bufferEnd;\n  parser->m_parseEndByteIndex += len;\n  parser->m_parsingStatus.finalBuffer = (XML_Bool)isFinal;\n\n  parser->m_errorCode = parser->m_processor(\n      parser, start, parser->m_parseEndPtr, &parser->m_bufferPtr);\n"
            }
          ]
        },
        "after": {
          "requirement": "On the same parser, leave a partial token on a nonfinal call, then make another nonfinal call while the pending byte count is below the retry threshold and buffer space is sufficient.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The new skip decision needs an intermediate nonfinal call. The harness makes only one nonfinal XML_Parse call, then calls XML_Parse with isFinal=1; the final call bypasses deferral.",
          "source_evidence": [
            {
              "evidence_id": "loc-2bb778c2d173d7994e1b58b6",
              "quote": "static enum XML_Error\ncallProcessor(XML_Parser parser, const char *start, const char *end,\n              const char **endPtr) {\n  const size_t have_now = EXPAT_SAFE_PTR_DIFF(end, start);\n\n  if (parser->m_reparseDeferralEnabled\n      && ! parser->m_parsingStatus.finalBuffer) {\n    // Heuristic: don't try to parse a partial token again until the amount of\n    // available data has increased significantly.\n    const size_t had_before = parser->m_partialTokenBytesBefore;\n    // ...but *do* try anyway if we're close to causing a reallocation.\n    size_t available_buffer\n        = EXPAT_SAFE_PTR_DIFF(parser->m_bufferPtr, parser->m_buffer);\n#if XML_CONTEXT_BYTES > 0\n    available_buffer -= EXPAT_MIN(available_buffer, XML_CONTEXT_BYTES);\n#endif\n    available_buffer\n        += EXPAT_SAFE_PTR_DIFF(parser->m_bufferLim, parser->m_bufferEnd);\n    // m_lastBufferRequestSize is never assigned a value < 0, so the cast is ok\n    const bool enough\n        = (have_now >= 2 * had_before)\n          || ((size_t)parser->m_lastBufferRequestSize > available_buffer);\n\n    if (! enough) {\n      *endPtr = start; // callers may expect this to be set\n      return XML_ERROR_NONE;\n    }\n  }\n  g_parseAttempts += 1;\n  const enum XML_Error ret = parser->m_processor(parser, start, end, endPtr);\n  if (ret == XML_ERROR_NONE) {\n    // if we consumed nothing, remember what we had on this parse attempt.\n    if (*endPtr == start) {\n      parser->m_partialTokenBytesBefore = have_now;\n    } else {\n      parser->m_partialTokenBytesBefore = 0;\n    }\n  }\n  return ret;\n}\n"
            },
            {
              "evidence_id": "loc-bfc735eb4d2a96be68c68e7d",
              "quote": "  parser->m_bufferPtr = parser->m_buffer;\n  parser->m_bufferEnd = parser->m_buffer;\n  parser->m_parseEndByteIndex = 0;\n  parser->m_parseEndPtr = NULL;\n  parser->m_partialTokenBytesBefore = 0;\n  parser->m_reparseDeferralEnabled = g_reparseDeferralEnabledDefault;\n  parser->m_lastBufferRequestSize = 0;\n"
            },
            {
              "evidence_id": "loc-eead70d36d8e834cd1dba976",
              "quote": "  start = parser->m_bufferPtr;\n  parser->m_positionPtr = start;\n  parser->m_bufferEnd += len;\n  parser->m_parseEndPtr = parser->m_bufferEnd;\n  parser->m_parseEndByteIndex += len;\n  parser->m_parsingStatus.finalBuffer = (XML_Bool)isFinal;\n\n  parser->m_errorCode = callProcessor(parser, start, parser->m_parseEndPtr,\n                                      &parser->m_bufferPtr);\n"
            }
          ]
        },
        "same_blocker": "not_applicable",
        "reason": "Before the change there was no corresponding skip decision. After the change, the harness's fixed nonfinal-then-final call sequence cannot exercise it.",
        "error": null,
        "missing_information": []
      }
    ],
