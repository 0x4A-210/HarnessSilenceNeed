        "claims": [
          {
            "claim_id": "c1",
            "status": "introduced",
            "necessary": "yes",
            "before": {
              "requirement": "Reject a misplaced minus using exponent state reconstructed from a previous parse_ex call.",
              "applicability": "not_applicable",
              "harness_status": "not_applicable",
              "reason": "The old number path initializes exponent state afresh on each call and has no saved-exponent reconstruction. Its generic minus check is a different behavior.",
              "source_evidence": [
                {
                  "evidence_id": "loc-cc9719e54246970ef3d24e70",
                  "quote": "\t\tcase json_tokener_state_number:\n\t\t{\n\t\t\t/* Advance until we change state */\n\t\t\tconst char *case_start = str;\n\t\t\tint case_len = 0;\n\t\t\tint is_exponent = 0;\n\t\t\tint negativesign_next_possible_location = 1;\n\t\t\twhile (c && strchr(json_number_chars, c))\n"
                },
                {
                  "evidence_id": "loc-408e419a518d4449ab97565a",
                  "quote": "\t\t\t\tif (c == 'e' || c == 'E')\n\t\t\t\t{\n\t\t\t\t\tif (is_exponent != 0)\n\t\t\t\t\t{\n\t\t\t\t\t\t/* only one exponent possible */\n\t\t\t\t\t\ttok->err = json_tokener_error_parse_number;\n\t\t\t\t\t\tgoto out;\n\t\t\t\t\t}\n\t\t\t\t\tis_exponent = 1;\n\t\t\t\t\ttok->is_double = 1;\n\t\t\t\t\t/* the exponent part can begin with a negative sign */\n\t\t\t\t\tnegativesign_next_possible_location = case_len + 1;\n\t\t\t\t}\n\t\t\t\tif (c == '-' && case_len != negativesign_next_possible_location)\n\t\t\t\t{\n\t\t\t\t\t/* If the negative sign is not where expected (ie\n\t\t\t\t\t * start of input or start of exponent part), the\n\t\t\t\t\t * input is invalid.\n\t\t\t\t\t */\n\t\t\t\t\ttok->err = json_tokener_error_parse_number;\n\t\t\t\t\tgoto out;\n\t\t\t\t}\n\n\t\t\t\tif (!ADVANCE_CHAR(str, tok) || !PEEK_CHAR(c, tok))\n\t\t\t\t{\n\t\t\t\t\tprintbuf_memappend_fast(tok->pb, case_start, case_len);\n\t\t\t\t\tgoto out;\n"
                }
              ]
            },
            "after": {
              "requirement": "Reach saved-exponent reconstruction and reject a misplaced continuation minus on the same tokener.",
              "applicability": "required",
              "harness_status": "unsat",
              "reason": "The added reconstruction distinguishes an exponent already saved in the tokener, then the minus guard rejects the continuation. The harness calls parse_ex only once.",
              "source_evidence": [
                {
                  "evidence_id": "loc-5fb5a1224a3560555950b989",
                  "quote": "\t\tcase json_tokener_state_number:\n\t\t{\n\t\t\t/* Advance until we change state */\n\t\t\tconst char *case_start = str;\n\t\t\tint case_len = 0;\n\t\t\tint is_exponent = 0;\n\t\t\tint negativesign_next_possible_location = 1;\n\t\t\tif (printbuf_length(tok->pb) > 0)\n\t\t\t{\n\t\t\t\t/* We don't save all state from the previous incremental parse\n\t\t\t\t   so we need to re-generate it based on the saved string so far.\n\t\t\t\t */\n\t\t\t\tchar *e_loc = strchr(tok->pb->buf, 'e');\n\t\t\t\tif (!e_loc)\n\t\t\t\t\te_loc = strchr(tok->pb->buf, 'E');\n\t\t\t\tif (e_loc)\n\t\t\t\t{\n\t\t\t\t\tchar *last_saved_char =\n\t\t\t\t\t    &tok->pb->buf[printbuf_length(tok->pb) - 1];\n\t\t\t\t\tis_exponent = 1;\n\t\t\t\t\t/* If the \"e\" isn't at the end, we can't start with a '-' */\n\t\t\t\t\tif (e_loc != last_saved_char)\n\t\t\t\t\t\tnegativesign_next_possible_location = -1;\n\t\t\t\t\t// else leave it set to 1, i.e. start of the new input\n\t\t\t\t}\n\t\t\t}\n"
                },
                {
                  "evidence_id": "loc-6dcedee994db59eeec84ad09",
                  "quote": "\t\t\t\tcase '-':\n\t\t\t\t\tif (case_len != negativesign_next_possible_location)\n\t\t\t\t\t{\n\t\t\t\t\t\t/* If the negative sign is not where expected (ie\n\t\t\t\t\t\t * start of input or start of exponent part), the\n\t\t\t\t\t\t * input is invalid.\n\t\t\t\t\t\t */\n\t\t\t\t\t\ttok->err = json_tokener_error_parse_number;\n\t\t\t\t\t\tgoto out;\n\t\t\t\t\t}\n\t\t\t\t\tbreak;\n\t\t\t\tdefault: break;\n\t\t\t\t}\n\n\t\t\t\tif (!ADVANCE_CHAR(str, tok) || !PEEK_CHAR(c, tok))\n\t\t\t\t{\n\t\t\t\t\tprintbuf_memappend_fast(tok->pb, case_start, case_len);\n\t\t\t\t\tgoto out;\n"
                },
                {
                  "evidence_id": "loc-4f16d05bc48979b27184d3ed",
                  "quote": "* Fix incremental parsing of numbers, especially those with exponents, e.g.\n   so parsing \"[0\", \"e+\", \"-]\" now properly returns an error.\n"
                }
              ]
            },
            "same_blocker": "not_applicable",
            "reason": "The one-call harness constraint existed on both sides, but the same saved-exponent rejection obligation did not exist before.",
            "error": null,
            "missing_information": []
          },
          {
            "claim_id": "c2",
            "status": "introduced",
            "necessary": "yes",
            "before": {
              "requirement": "Produce the strict-mode number error for an incomplete exponent such as \"[0e]\".",
              "applicability": "not_applicable",
              "harness_status": "not_applicable",
              "reason": "The old parser has no strict-specific incomplete-exponent rejection at number conversion; it passes the buffer to the old double parser instead.",
              "source_evidence": [
                {
                  "evidence_id": "loc-22dcfea865c459416972fdfc",
                  "quote": "\t\t\tif (case_len > 0)\n\t\t\t\tprintbuf_memappend_fast(tok->pb, case_start, case_len);\n\n\t\t\t// Check for -Infinity\n\t\t\tif (tok->pb->buf[0] == '-' && case_len <= 1 && (c == 'i' || c == 'I'))\n\t\t\t{\n\t\t\t\tstate = json_tokener_state_inf;\n\t\t\t\ttok->st_pos = 0;\n\t\t\t\tgoto redo_char;\n\t\t\t}\n\t\t}\n"
                },
                {
                  "evidence_id": "loc-b73bb51b9c5b6aafb21b1db7",
                  "quote": "\t\t\t\telse if (tok->is_double &&\n\t\t\t\t         json_parse_double(tok->pb->buf, &numd) == 0)\n\t\t\t\t{\n\t\t\t\t\tcurrent = json_object_new_double_s(numd, tok->pb->buf);\n\t\t\t\t\tif (current == NULL)\n\t\t\t\t\t\tgoto out;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\ttok->err = json_tokener_error_parse_number;\n\t\t\t\t\tgoto out;\n"
                }
              ]
            },
            "after": {
              "requirement": "Reach strict-mode rejection of the missing exponent in \"[0e]\".",
              "applicability": "required",
              "harness_status": "unsat",
              "reason": "The added trim applies only without JSON_TOKENER_STRICT; the supplied after cases specify success by default and a number error in strict mode. The harness has no flag-setting call.",
              "source_evidence": [
                {
                  "evidence_id": "loc-eb8a20c58073dcbd4bed16e5",
                  "quote": "\t\t\tif (tok->is_double && !(tok->flags & JSON_TOKENER_STRICT))\n\t\t\t{\n\t\t\t\t/* Trim some chars off the end, to allow things\n\t\t\t\t   like \"123e+\" to parse ok. */\n\t\t\t\twhile (printbuf_length(tok->pb) > 1)\n\t\t\t\t{\n\t\t\t\t\tchar last_char = tok->pb->buf[printbuf_length(tok->pb) - 1];\n\t\t\t\t\tif (last_char != 'e' && last_char != 'E' &&\n\t\t\t\t\t    last_char != '-' && last_char != '+')\n\t\t\t\t\t{\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t\ttok->pb->buf[printbuf_length(tok->pb) - 1] = '\\0';\n\t\t\t\t\tprintbuf_length(tok->pb)--;\n\t\t\t\t}\n\t\t\t}\n"
                },
                {
                  "evidence_id": "loc-1f4a06b6092b5c8ab4958f4b",
                  "quote": "\t\t\t\telse if (tok->is_double &&\n\t\t\t\t         json_tokener_parse_double(\n\t\t\t\t             tok->pb->buf, printbuf_length(tok->pb), &numd) == 0)\n\t\t\t\t{\n\t\t\t\t\tcurrent = json_object_new_double_s(numd, tok->pb->buf);\n\t\t\t\t\tif (current == NULL)\n\t\t\t\t\t\tgoto out;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\ttok->err = json_tokener_error_parse_number;\n\t\t\t\t\tgoto out;\n\t\t\t\t}\n"
                },
                {
                  "evidence_id": "loc-e277792effdd2f0d5dcc6b5c",
                  "quote": "    {\"[0e]\", -1, -1, json_tokener_success, 1},\n    {\"[0e]\", -1, 3, json_tokener_error_parse_number, 1, JSON_TOKENER_STRICT},\n"
                }
              ]
            },
            "same_blocker": "not_applicable",
            "reason": "The default-only harness setup existed before, but the specific strict rejection of a missing exponent is supported only after the change.",
