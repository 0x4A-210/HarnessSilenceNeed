        "id": "N1",
        "change_ids": [],
        "kind": "lifecycle",
        "necessary": true,
        "established": true,
        "requirement": "Every gzFile that the harness opens must be released before it drops the handle.",
        "target_route": "LLVMFuzzerTestOneInput -> gzopen(mode \"w\") -> case 21 gzclose_r(file); file = NULL -> gzclose(NULL)",
        "failure_condition": "Input 02 77 15 opens the file with mode \"w\" (write). Op 1 is 'w'%26=15 (gzdirect). Op 2 is 0x15=21, which calls gzclose_r on the write handle. gzclose_r returns Z_STREAM_ERROR without freeing the state or closing the fd. The harness then sets file=NULL, so the final gzclose(NULL) frees nothing. The heap state and the fd leak on every such input.",
        "alternative_paths": "None. After the handle is nulled, the harness keeps no other reference, and gzclose(NULL) returns early.",
        "source_evidence": [
          {
            "unit_id": "u-9d55198015f58d69c1ae",
            "start_line": 646,
            "end_line": 662,
            "role": "primary",
            "dependency_reason": "Non-read handles return before the free(state) and close(fd) calls."
