              "end_line": 443,
              "role": "dependency",
              "dependency_reason": "gzseek takes whence as an argument."
            }
          ]
        },
        "feasible_trigger": {
          "status": "established",
          "reason": "The decoding at lines 33-44 leaves data pointing at the op byte, so the witness bytes reach case 4 with dataLen=1.",
          "evidence": [
            {
              "unit_id": "u-1ff4587e1cb89bf573f9",
              "start_line": 33,
              "end_line": 44,
              "role": "primary",
              "dependency_reason": "Mode and op decoding."
