    "introduced_by_this_change": true,
    "claims": [
      {
        "claim_id": "c1",
        "status": "introduced",
        "necessary": "yes",
        "before": {
          "requirement": "Execute the added sequence-end branch in the flow-sequence mapping-key function.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The before function has no such branch; a sequence-end token takes its existing empty-scalar path.",
          "source_evidence": [
            {
              "evidence_id": "loc-e95ce61ffc8f2cb237a09757",
              "quote": "    token = PEEK_TOKEN(parser);\n    if (!token) return 0;\n\n    if (token->type != YAML_VALUE_TOKEN && token->type != YAML_FLOW_ENTRY_TOKEN\n            && token->type != YAML_FLOW_SEQUENCE_END_TOKEN) {\n        if (!PUSH(parser, parser->states,\n                    YAML_PARSE_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE_STATE))\n            return 0;\n        return yaml_parser_parse_node(parser, event, 0, 0);\n    }\n    else {\n        yaml_mark_t mark = token->end_mark;\n        SKIP_TOKEN(parser);\n        parser->state = YAML_PARSE_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE_STATE;\n        return yaml_parser_process_empty_scalar(parser, event, mark);\n    }\n"
            }
          ]
        },
        "after": {
          "requirement": "Continue parsing `[?]` until the added sequence-end branch executes.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The after function adds that branch, but the harness exits when copying its first stream-start event succeeds.",
          "source_evidence": [
            {
              "evidence_id": "loc-017613cb83a62723c96c505c",
              "quote": "    token = PEEK_TOKEN(parser);\n    if (!token) return 0;\n\n    if (token->type != YAML_VALUE_TOKEN && token->type != YAML_FLOW_ENTRY_TOKEN\n            && token->type != YAML_FLOW_SEQUENCE_END_TOKEN) {\n        if (!PUSH(parser, parser->states,\n                    YAML_PARSE_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE_STATE))\n            return 0;\n        return yaml_parser_parse_node(parser, event, 0, 0);\n    }\n    else if (token->type == YAML_FLOW_SEQUENCE_END_TOKEN) {\n        parser->state = POP(parser, parser->states);\n        (void)POP(parser, parser->marks);\n        SEQUENCE_END_EVENT_INIT(*event, token->start_mark, token->end_mark);\n        SKIP_TOKEN(parser);\n        return 1;\n    }\n"
            },
            {
              "evidence_id": "loc-f74c2d20797d54a4ef13af34",
              "quote": "    /* Is it the flow sequence start indicator? */\n\n    if (CHECK(parser->buffer, '['))\n        return yaml_parser_fetch_flow_collection_start(parser,\n                YAML_FLOW_SEQUENCE_START_TOKEN);\n\n    /* Is it the flow mapping start indicator? */\n\n    if (CHECK(parser->buffer, '{'))\n        return yaml_parser_fetch_flow_collection_start(parser,\n                YAML_FLOW_MAPPING_START_TOKEN);\n\n    /* Is it the flow sequence end indicator? */\n\n    if (CHECK(parser->buffer, ']'))\n        return yaml_parser_fetch_flow_collection_end(parser,\n                YAML_FLOW_SEQUENCE_END_TOKEN);\n\n    /* Is it the flow mapping end indicator? */\n\n    if (CHECK(parser->buffer, '}'))\n        return yaml_parser_fetch_flow_collection_end(parser,\n                YAML_FLOW_MAPPING_END_TOKEN);\n\n    /* Is it the flow entry indicator? */\n\n    if (CHECK(parser->buffer, ','))\n        return yaml_parser_fetch_flow_entry(parser);\n\n    /* Is it the block entry indicator? */\n\n    if (CHECK(parser->buffer, '-') && IS_BLANKZ_AT(parser->buffer, 1))\n        return yaml_parser_fetch_block_entry(parser);\n\n    /* Is it the key indicator? */\n\n    if (CHECK(parser->buffer, '?')\n            && (parser->flow_level || IS_BLANKZ_AT(parser->buffer, 1)))\n        return yaml_parser_fetch_key(parser);\n"
            },
            {
              "evidence_id": "loc-ffaacb255e43588351488007",
              "quote": "static int\nyaml_parser_parse_stream_start(yaml_parser_t *parser, yaml_event_t *event)\n{\n    yaml_token_t *token;\n\n    token = PEEK_TOKEN(parser);\n    if (!token) return 0;\n\n    if (token->type != YAML_STREAM_START_TOKEN) {\n        return yaml_parser_set_parser_error(parser,\n                \"did not find expected <stream-start>\", token->start_mark);\n    }\n\n    parser->state = YAML_PARSE_IMPLICIT_DOCUMENT_START_STATE;\n    STREAM_START_EVENT_INIT(*event, token->data.stream_start.encoding,\n            token->start_mark, token->start_mark);\n    SKIP_TOKEN(parser);\n\n    return 1;\n"
            },
            {
              "evidence_id": "loc-cca2f4199522799a36fb4682",
              "quote": "YAML_DECLARE(int)\nyaml_stream_start_event_initialize(yaml_event_t *event,\n        yaml_encoding_t encoding)\n{\n    yaml_mark_t mark = { 0, 0, 0 };\n\n    assert(event);  /* Non-NULL event object is expected. */\n\n    STREAM_START_EVENT_INIT(*event, encoding, mark, mark);\n\n    return 1;\n}\n"
            }
          ]
        },
        "same_blocker": "not_applicable",
        "reason": "The old exit condition is unchanged, but c1 concerns execution of the newly added branch. That branch had no before-side requirement, so the old exit is not timed as a different obligation here.",
