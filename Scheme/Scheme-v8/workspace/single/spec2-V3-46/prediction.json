            "before": {
              "requirement": "For CBOR bytes {0xf9, 0x7c, 0x01}, the existing decode–encode–decode equality assertion must hold.",
              "applicability": "required",
              "harness_status": "sat",
              "reason": "The half precision value decodes to NaN, but the old floating point constructor converts it to JSON null. CBOR encoding and decoding preserve null, and two JSON null values compare equal.",
              "source_evidence": [
                {
                  "evidence_id": "loc-57917ab5f5f489a4f98d3dc6",
                  "quote": "            case 0xf9: // Half-Precision Float (two-byte IEEE 754)\n            {\n                idx += 2; // skip two content bytes\n\n                // code from RFC 7049, Appendix D, Figure 3:\n                // As half-precision floating-point numbers were only added to\n                // IEEE 754 in 2008, today's programming platforms often still\n                // only have limited support for them. It is very easy to\n                // include at least decoding support for them even without such\n                // support. An example of a small decoder for half-precision\n                // floating-point numbers in the C language is shown in Fig. 3.\n                const int half = (v.at(current_idx + 1) << 8) + v.at(current_idx + 2);\n                const int exp = (half >> 10) & 0x1f;\n                const int mant = half & 0x3ff;\n                double val;\n                if (exp == 0)\n                {\n                    val = std::ldexp(mant, -24);\n                }\n                else if (exp != 31)\n                {\n                    val = std::ldexp(mant + 1024, exp - 25);\n                }\n                else\n                {\n                    val = mant == 0\n                          ? std::numeric_limits<double>::infinity()\n                          : std::numeric_limits<double>::quiet_NaN();\n                }\n                return (half & 0x8000) != 0 ? -val : val;\n"
                },
                {
                  "evidence_id": "loc-65cc53cabfd8bf64830f850a",
                  "quote": "template<typename BasicJsonType, typename FloatType,\n         enable_if_t<std::is_floating_point<FloatType>::value, int> = 0>\nvoid to_json(BasicJsonType& j, FloatType val) noexcept\n{\n    external_constructor<value_t::number_float>::construct(j, static_cast<typename BasicJsonType::number_float_t>(val));\n}\n"
                },
                {
                  "evidence_id": "loc-c7390e71570cec072665127b",
                  "quote": "    static void construct(BasicJsonType& j, typename BasicJsonType::number_float_t val) noexcept\n    {\n        // replace infinity and NAN by null\n        if (not std::isfinite(val))\n        {\n            j = BasicJsonType{};\n        }\n        else\n        {\n            j.m_type = value_t::number_float;\n            j.m_value = val;\n        }\n        j.assert_invariant();\n    }\n"
                },
                {
                  "evidence_id": "loc-6884e865f6d9e3f9f9c5473b",
                  "quote": "    static void to_cbor_internal(const basic_json& j, std::vector<uint8_t>& v)\n    {\n        switch (j.type())\n        {\n            case value_t::null:\n            {\n                v.push_back(0xf6);\n                break;\n"
                },
                {
                  "evidence_id": "loc-ff4091017cd365b978205fbf",
                  "quote": "            case 0xf6: // null\n            {\n                return value_t::null;\n            }\n"
                },
                {
                  "evidence_id": "loc-ed0c8f04ea03d30db6225d6f",
                  "quote": "                case value_t::null:\n                {\n                    return true;\n                }\n"
                }
              ]
            },
            "after": {
              "requirement": "For the same CBOR bytes {0xf9, 0x7c, 0x01}, the existing decode–encode–decode equality assertion must hold.",
              "applicability": "required",
              "harness_status": "unsat",
              "reason": "The changed constructor retains NaN as a JSON float. CBOR encoding writes a double precision float, decoding restores NaN, and the existing equality operator compares the two NaNs with ordinary floating point ==, which is false.",
              "source_evidence": [
                {
                  "evidence_id": "loc-9d7f4c15a3869791ff6e29bd",
                  "quote": "            case 0xf9: // Half-Precision Float (two-byte IEEE 754)\n            {\n                idx += 2; // skip two content bytes\n\n                // code from RFC 7049, Appendix D, Figure 3:\n                // As half-precision floating-point numbers were only added to\n                // IEEE 754 in 2008, today's programming platforms often still\n                // only have limited support for them. It is very easy to\n                // include at least decoding support for them even without such\n                // support. An example of a small decoder for half-precision\n                // floating-point numbers in the C language is shown in Fig. 3.\n                const int half = (v.at(current_idx + 1) << 8) + v.at(current_idx + 2);\n                const int exp = (half >> 10) & 0x1f;\n                const int mant = half & 0x3ff;\n                double val;\n                if (exp == 0)\n                {\n                    val = std::ldexp(mant, -24);\n                }\n                else if (exp != 31)\n                {\n                    val = std::ldexp(mant + 1024, exp - 25);\n                }\n                else\n                {\n                    val = mant == 0\n                          ? std::numeric_limits<double>::infinity()\n                          : std::numeric_limits<double>::quiet_NaN();\n                }\n                return (half & 0x8000) != 0 ? -val : val;\n"
                },
                {
                  "evidence_id": "loc-068f29139e8a94454a28561e",
                  "quote": "template<typename BasicJsonType, typename FloatType,\n         enable_if_t<std::is_floating_point<FloatType>::value, int> = 0>\nvoid to_json(BasicJsonType& j, FloatType val) noexcept\n{\n    external_constructor<value_t::number_float>::construct(j, static_cast<typename BasicJsonType::number_float_t>(val));\n}\n"
                },
                {
                  "evidence_id": "loc-cf4822bbfefc8abf90e81997",
                  "quote": "    static void construct(BasicJsonType& j, typename BasicJsonType::number_float_t val) noexcept\n    {\n        j.m_type = value_t::number_float;\n        j.m_value = val;\n        j.assert_invariant();\n    }\n"
                },
                {
                  "evidence_id": "loc-c04f18dc95e82ca7474c26a6",
                  "quote": "            case value_t::number_float:\n            {\n                // Double-Precision Float\n                v.push_back(0xfb);\n                const auto* helper = reinterpret_cast<const uint8_t*>(&(j.m_value.number_float));\n                for (size_t i = 0; i < 8; ++i)\n                {\n                    v.push_back(helper[7 - i]);\n                }\n                break;\n"
                },
                {
                  "evidence_id": "loc-a57a1e59ada3236a5b6cae8f",
                  "quote": "            case 0xfb: // Double-Precision Float (eight-byte IEEE 754)\n            {\n                // copy bytes in reverse order into the double variable\n                double res;\n                for (size_t byte = 0; byte < sizeof(double); ++byte)\n                {\n                    reinterpret_cast<uint8_t*>(&res)[sizeof(double) - byte - 1] = v.at(current_idx + 1 + byte);\n                }\n                idx += sizeof(double); // skip content bytes\n                return res;\n"
                },
                {
                  "evidence_id": "loc-a3e85a72a3199ab902f2442d",
                  "quote": "                case value_t::number_float:\n                {\n                    return lhs.m_value.number_float == rhs.m_value.number_float;\n                }\n"
                }
              ]
