        "before": {
          "requirement": "Execute saved-exponent state restoration in parse_ex.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The complete before function proceeds from number-state local initialization directly to scanning; this restoration did not yet exist.",
          "source_evidence": [
            {
              "evidence_id": "loc-cc9719e54246970ef3d24e70",
              "quote": "\t\tcase json_tokener_state_number:\n\t\t{\n\t\t\t/* Advance until we change state */\n\t\t\tconst char *case_start = str;\n\t\t\tint case_len = 0;\n\t\t\tint is_exponent = 0;\n\t\t\tint negativesign_next_possible_location = 1;\n\t\t\twhile (c && strchr(json_number_chars, c))\n"
            },
            {
              "evidence_id": "loc-e09f81ff6c88d90a8310808a",
              "quote": "\t\t\t\tif (!ADVANCE_CHAR(str, tok) || !PEEK_CHAR(c, tok))\n\t\t\t\t{\n\t\t\t\t\tprintbuf_memappend_fast(tok->pb, case_start, case_len);\n\t\t\t\t\tgoto out;\n\t\t\t\t}\n"
            }
          ]
        },
        "after": {
          "requirement": "Execute saved-exponent state restoration by continuing an unfinished number in another parse_ex call on the same tokener.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The new branch inspects a previously saved number buffer. The fixed harness makes one parse call on a fresh tokener and then frees it.",
          "source_evidence": [
            {
              "evidence_id": "loc-4c1c1d3f5e0377bfce48d6e1",
              "quote": "\t\tcase json_tokener_state_number:\n\t\t{\n\t\t\t/* Advance until we change state */\n\t\t\tconst char *case_start = str;\n\t\t\tint case_len = 0;\n\t\t\tint is_exponent = 0;\n\t\t\tint negativesign_next_possible_location = 1;\n\t\t\tif (printbuf_length(tok->pb) > 0)\n\t\t\t{\n\t\t\t\t/* We don't save all state from the previous incremental parse\n\t\t\t\t   so we need to re-generate it based on the saved string so far.\n\t\t\t\t */\n\t\t\t\tchar *e_loc = strchr(tok->pb->buf, 'e');\n\t\t\t\tif (!e_loc)\n\t\t\t\t\te_loc = strchr(tok->pb->buf, 'E');\n\t\t\t\tif (e_loc)\n\t\t\t\t{\n\t\t\t\t\tchar *last_saved_char =\n\t\t\t\t\t    &tok->pb->buf[printbuf_length(tok->pb) - 1];\n\t\t\t\t\tis_exponent = 1;\n\t\t\t\t\t/* If the \"e\" isn't at the end, we can't start with a '-' */\n\t\t\t\t\tif (e_loc != last_saved_char)\n\t\t\t\t\t\tnegativesign_next_possible_location = -1;\n\t\t\t\t\t// else leave it set to 1, i.e. start of the new input\n\t\t\t\t}\n\t\t\t}\n\t\t\twhile (c && strchr(json_number_chars, c))\n"
            },
            {
              "evidence_id": "loc-869373a6d4b5ef5864df6368",
              "quote": "\t\t\t\tif (!ADVANCE_CHAR(str, tok) || !PEEK_CHAR(c, tok))\n\t\t\t\t{\n\t\t\t\t\tprintbuf_memappend_fast(tok->pb, case_start, case_len);\n\t\t\t\t\tgoto out;\n"
            }
          ]
        },
