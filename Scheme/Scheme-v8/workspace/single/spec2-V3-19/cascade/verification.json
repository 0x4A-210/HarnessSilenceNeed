    "claims": [
      {
        "claim_id": "c1",
        "status": "introduced",
        "necessary": "yes",
        "before": {
          "requirement": "Execute the specific sentinel-removal branch added by g0002 when CHARBOUND and STRIPCC are combined.",
          "applicability": "not_applicable",
          "harness_status": "not_applicable",
          "reason": "The before function has no sentinel-removal branch. The same code-executability obligation therefore did not exist on this side.",
          "source_evidence": [
            {
              "evidence_id": "loc-7e70afe97eb337f5691525cb",
              "quote": "UTF8PROC_DLLEXPORT utf8proc_ssize_t utf8proc_normalize_utf32(utf8proc_int32_t *buffer, utf8proc_ssize_t length, unsigned int options) {\n  /* UTF8PROC_NULLTERM option will be ignored, 'length' is never ignored */\n  if (options & (UTF8PROC_NLF2LS | UTF8PROC_NLF2PS | UTF8PROC_STRIPCC)) {\n    utf8proc_ssize_t rpos;\n    utf8proc_ssize_t wpos = 0;\n    utf8proc_int32_t uc;\n    for (rpos = 0; rpos < length; rpos++) {\n      uc = buffer[rpos];\n      if (uc == 0x000D && rpos < length-1 && buffer[rpos+1] == 0x000A) rpos++;\n      if (uc == 0x000A || uc == 0x000D || uc == 0x0085 ||\n          ((options & UTF8PROC_STRIPCC) && (uc == 0x000B || uc == 0x000C))) {\n        if (options & UTF8PROC_NLF2LS) {\n          if (options & UTF8PROC_NLF2PS) {\n            buffer[wpos++] = 0x000A;\n          } else {\n            buffer[wpos++] = 0x2028;\n          }\n        } else {\n          if (options & UTF8PROC_NLF2PS) {\n            buffer[wpos++] = 0x2029;\n          } else {\n            buffer[wpos++] = 0x0020;\n          }\n        }\n      } else if ((options & UTF8PROC_STRIPCC) &&\n          (uc < 0x0020 || (uc >= 0x007F && uc < 0x00A0))) {\n        if (uc == 0x0009) buffer[wpos++] = 0x0020;\n      } else {\n        buffer[wpos++] = uc;\n      }\n    }\n    length = wpos;\n  }\n"
            },
            {
              "evidence_id": "loc-46e824e520d44135294f741d",
              "quote": "  if (options & UTF8PROC_CHARBOUND) {\n    utf8proc_bool boundary;\n    boundary = grapheme_break_extended(0, property->boundclass, 0, property->indic_conjunct_break,\n                                       last_boundclass);\n    if (boundary) {\n      if (bufsize >= 1) dst[0] = -1; /* sentinel value for grapheme break */\n      if (bufsize >= 2) dst[1] = uc;\n      return 2;\n"
            }
          ]
        },
        "after": {
          "requirement": "Execute the added branch that removes a CHARBOUND sentinel before a control stripped by STRIPCC.",
          "applicability": "required",
          "harness_status": "unsat",
          "reason": "The added branch requires both flags, while the old harness's direct normalization and mapping calls never combine them.",
          "source_evidence": [
            {
              "evidence_id": "loc-18c29bf5226a97a629acf7b6",
              "quote": "      } else if ((options & UTF8PROC_STRIPCC) &&\n          /* uc < 0 is a grapheme-break sentinel from UTF8PROC_CHARBOUND,\n             not a control character, so keep it */\n          ((uc >= 0 && uc < 0x0020) || (uc >= 0x007F && uc < 0x00A0))) {\n        if (uc == 0x0009) buffer[wpos++] = 0x0020;\n        /* a removed control character is a grapheme of its own, so also\n           drop the boundary sentinel that UTF8PROC_CHARBOUND put before it */\n        else if ((options & UTF8PROC_CHARBOUND) && wpos > 0 && buffer[wpos-1] == -1) wpos--;\n      } else {\n        buffer[wpos++] = uc;\n"
            },
            {
              "evidence_id": "loc-20b0b82087a440f22fddd68a",
              "quote": "  if (options & UTF8PROC_CHARBOUND) {\n    utf8proc_bool boundary;\n    boundary = grapheme_break_extended(0, property->boundclass, 0, property->indic_conjunct_break,\n                                       last_boundclass);\n    if (boundary) {\n      if (bufsize >= 1) dst[0] = -1; /* sentinel value for grapheme break */\n      if (bufsize >= 2) dst[1] = uc;\n      return 2;\n"
            },
            {
              "evidence_id": "loc-5eff104ad6247ea6387900a8",
              "quote": "  *dstptr = NULL;\n  bufsize = utf8proc_decompose_custom(str, strlen, NULL, 0, options, custom_func, custom_data);\n  if (bufsize < 0) return bufsize;\n  buffer = (utf8proc_int32_t *) malloc(((utf8proc_size_t)bufsize) * sizeof(utf8proc_int32_t) + 1);\n  if (!buffer) return UTF8PROC_ERROR_NOMEM;\n  result = utf8proc_decompose_custom(str, strlen, buffer, bufsize, options, custom_func, custom_data);\n  if (result < 0) {\n    free(buffer);\n    return result;\n  }\n  /* a custom_func that returns different results across the two decompose\n     passes can make the second pass longer than the buffer we sized from the\n     first; reencode would then read and write past the allocation, so bail\n     out instead of corrupting the heap */\n  if (result > bufsize) {\n    free(buffer);\n    return UTF8PROC_ERROR_OVERFLOW;\n  }\n  result = utf8proc_reencode(buffer, result, options);\n"
            }
          ]
        },
