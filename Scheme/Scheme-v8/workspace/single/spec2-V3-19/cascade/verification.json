      "change_ids": [
        "g0002"
      ],
      "requirement": "Exercise the added removal of a grapheme boundary sentinel before a stripped control character through a map call with UTF8PROC_CHARBOUND | UTF8PROC_STRIPCC.",
      "target_route": "A valid input beginning with 0x01 followed by 'a' reaches the added branch when mapped with both flags: decomposition inserts the sentinel, then normalization strips the control.",
      "failure_condition": "No existing target call supplies both flags. Direct UTF-32 normalization supplies STRIPCC without CHARBOUND; mapping calls that supply CHARBOUND omit STRIPCC.",
      "alternative_paths": "utf8proc_map passes options unchanged through decomposition and reencoding. The normalization shortcuts also omit both flags together; raw -1 values in the direct UTF-32 path cannot satisfy the branch's CHARBOUND guard.",
      "discovery_necessary": true,
      "discovery_established": true
    }
  ],
