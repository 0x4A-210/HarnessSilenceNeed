+        hash4 = 4 * (63 & (
+                ((this.pixel[0] as base.u32) * 3) +
+                ((this.pixel[1] as base.u32) * 5) +
+                ((this.pixel[2] as base.u32) * 7) +
+                ((this.pixel[3] as base.u32) * 11)))
