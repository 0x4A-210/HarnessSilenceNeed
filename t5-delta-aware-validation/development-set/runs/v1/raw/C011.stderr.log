+pub const DECODER_WORKBUF_LEN_MAX_INCL_WORST_CASE : base.u64 = 0
+
+pub struct decoder? implements base.image_decoder(
+        width  : base.u32[..= 0xFFFF],
+        height : base.u32[..= 0xFFFF],
