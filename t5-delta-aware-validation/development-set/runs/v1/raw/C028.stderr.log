+        this.probs_match_len_high[0][i] = 1024
+        i += 1
+    } endwhile
+
+    i = 0
+    while i < 16 {
+        j = 0
+        while j < 8,
+                inv i < 16,
+        {
+            this.probs_longrep_len_low[i][j] = 1024
+            j += 1
+        } endwhile
+        i += 1
+    } endwhile
+
+    i = 0
+    while i < 16 {
+        j = 0
+        while j < 8,
+                inv i < 16,
+        {
