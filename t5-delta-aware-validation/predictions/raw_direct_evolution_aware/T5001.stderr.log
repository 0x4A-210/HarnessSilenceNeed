+ares_status_t ares_queue_wait_empty(ares_channel_t *channel, int timeout_ms)
+{
+  ares_status_t  status = ARES_SUCCESS;
+  struct timeval tout;
+
+  if (!ares_threadsafety()) {
+    return ARES_ENOTIMP;
+  }
