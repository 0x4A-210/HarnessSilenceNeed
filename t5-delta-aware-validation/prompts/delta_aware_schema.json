{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "impact_scope", "gap_before", "gap_after", "new_harness_obligation", "explicit_failure", "delta_attribution", "maintenance_needed", "confidence", "reason"],
  "properties": {
    "case_id": {"type": "string"},
    "impact_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "files", "functions", "description"],
        "properties": {
          "type": {"enum": ["new_entry_point", "api_protocol_change", "state_change", "configuration_change", "input_semantic_change", "internal_only"]},
          "files": {"type": "array", "items": {"type": "string"}},
          "functions": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"}
        }
      }
    },
    "gap_before": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "type", "evidence"],
      "properties": {
        "exists": {"type": "boolean"},
        "type": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "gap_after": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "type", "evidence"],
      "properties": {
        "exists": {"type": "boolean"},
        "type": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "new_harness_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "description", "evidence"],
      "properties": {
        "exists": {"type": "boolean"},
        "description": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "explicit_failure": {"type": "boolean"},
    "delta_attribution": {"enum": ["NEW", "AGGRAVATED", "UNCHANGED", "REMOVED", "NONE"]},
    "maintenance_needed": {"type": "boolean"},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "reason": {"type": "string"}
  }
}
