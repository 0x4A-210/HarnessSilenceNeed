      goto exit;
    }
    workbuf = wuffs_base__malloc_slice_u8(malloc, n);
    if (!workbuf.ptr) {
      ret = "out of memory";
      goto exit;
    }

    n = wuffs_base__pixel_config__pixbuf_len(&ic.pixcfg);
    if (n > 64 * 1024 * 1024) {  // Don't allocate more than 64 MiB.
      ret = "image too large";
      goto exit;
    }
    pixbuf = wuffs_base__malloc_slice_u8(malloc, n);
