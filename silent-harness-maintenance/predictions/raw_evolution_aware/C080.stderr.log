                 wuffs_private_impl__swizzle_ycc__convert_3_func conv3func) =
       &wuffs_private_impl__swizzle_ycc__general__box_filter;
 
   void (*func4)(wuffs_base__pixel_buffer * dst,  //
                 uint32_t x_min_incl,             //
                 uint32_t x_max_excl,             //
                 uint32_t y_min_incl,             //
                 uint32_t y_max_excl,             //
