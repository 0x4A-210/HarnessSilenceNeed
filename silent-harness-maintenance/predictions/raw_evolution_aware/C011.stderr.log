 					stk.pop();
 					++it;
 			        }
 			}
 		        else
 			        ++it;
 		}
 		// Add matching brackets
 		while (!stk.empty())
 		{
 			_result += ']';
 			stk.pop();
 		}
 		// Remove colon inside brackets
 		std::stack<bool> insideBrackets;
 
 		// Remove colon within brackets
 		for (auto it = _result.begin(); it != _result.end(); /* no increment here */)
