 pub func hasher.update!(x: roslice base.u8) {
     var remaining : roslice base.u8
 
     if (this.length_modulo_u32 == 0) and not this.length_overflows_u32 {
         this.v0 = INITIAL_V0
         this.v1 = INITIAL_V1
         this.v2 = INITIAL_V2
