+ares_status_t ares_buf_set_position(ares_buf_t *buf, size_t idx)
+{
+  if (buf == NULL) {
+    return ARES_EFORMERR;
+  }
+
+  if (idx > buf->data_len) {
+    return ARES_EFORMERR; /* LCOV_EXCL_LINE: DefensiveCoding */
+  }
+
+  buf->offset = idx;
+  return ARES_SUCCESS;
+}
