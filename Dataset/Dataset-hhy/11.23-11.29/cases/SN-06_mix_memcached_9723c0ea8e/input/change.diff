+        return pools
+    elseif mode == "notdown" then
+        local down = mcp.backend({ label = "down", host = "127.0.0.1", port = 11517,
+                                   down = false })
+        local pools = {
+            test = mcp.pool({down})
+        }
+        return pools
     end
 end
 
