+    STAILQ_CONCAT(&head, &me->ion_head);
+    pthread_mutex_unlock(&me->ion_lock);
+
+    while (!STAILQ_EMPTY(&head)) {
+        io_pending_t *io = STAILQ_FIRST(&head);
+        STAILQ_REMOVE_HEAD(&head, iop_next);
