+static int str_needs_quotes(const char* str, size_t len)
+{
+    size_t i;
+    for (i = 0; i < len; i++) {
+        if (!allowed_unquoted_chars[(unsigned char)str[i]]) {
+            return 1;
+        }
+    }
+    return 0;
+}
