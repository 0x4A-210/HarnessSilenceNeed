  "blockers": [
   {
    "kind": "call_sequence",
    "detail": "on parse error the harness returns before ucl_parser_free(parser): every erroneous input leaks the parser (LeakSanitizer). OSS-Fuzz masks it with detect_leaks=0 in ucl_add_string_fuzzer.options"
   }
