  "oss": "libspng",
  "srcname": "libspng",
  "extra": [
   "zlib->zlib"
  ],
  "build_sed": [
   [
    "meson --buildtype=plain --default-library static build\\nninja -C build",
    "# meson is not available offline: compile the meson library target directly with its default options (optimize_defilter=true); -fcommon reproduces the pre-clang-11 default for the tentative definitions in common.h\\nmkdir -p build && for f in src/*.c; do $CC $CFLAGS -std=c99 -fcommon -DSPNG_OPTIMIZE_DEFILTER -msse2 -mssse3 -Isrc -c $f -o build/$(basename $f .c).o; done && ar rcs build/libspng.a build/*.o"
   ]
  ]
