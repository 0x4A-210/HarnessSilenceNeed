#!/bin/bash
# emulate older clang diagnostics: newer clang turned several warnings into errors and
# projects add -Werror; strip libc++ (not installed) and downgrade those to warnings
a=()
for x in "$@"; do case "$x" in -stdlib=libc++|-lc++|-lc++abi) ;; *) a+=("$x");; esac; done
exec /usr/bin/clang "${a[@]}" -Wno-error -Wno-error=int-conversion -Wno-error=incompatible-function-pointer-types -Wno-error=implicit-function-declaration -Wno-error=implicit-int -Wno-error=incompatible-pointer-types -Wno-unused-command-line-argument
