#!/bin/sh
# stand-in for the libtool-bin package (only used for presence checks such as flac's autogen.sh);
# real builds use the per-project ./libtool generated by configure
if [ "$1" = "--version" ]; then echo "libtool (GNU libtool) 2.4.7"; exit 0; fi
echo "bin/libtool stand-in called with: $*" >&2; exit 1
