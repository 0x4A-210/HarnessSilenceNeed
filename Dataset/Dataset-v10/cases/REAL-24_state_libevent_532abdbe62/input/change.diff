diff --git a/projects/libevent/evdns_client_fuzzer.cc b/projects/libevent/evdns_client_fuzzer.cc
new file mode 100644
index 000000000000..d2e9cb2fbd0d
--- /dev/null
+++ b/projects/libevent/evdns_client_fuzzer.cc
@@ -0,0 +1,387 @@
+/* Copyright 2026 Google LLC
