+#if 0                           /* This table is not actually needed in v6a */
+extern const int jpeg_zigzag_order[]; /* natural coef order to zigzag order */
+#endif
+extern const int jpeg12_natural_order[]; /* zigzag coef order to natural
+                                            order */
+
