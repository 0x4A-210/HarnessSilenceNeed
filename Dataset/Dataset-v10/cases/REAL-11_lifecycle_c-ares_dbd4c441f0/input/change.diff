diff --git a/ares_getaddrinfo.c b/ares_getaddrinfo.c
index dba5a00e8b88a5be655737389e173414fc189822..e67903b501ef6e3d17336613a1f576b1f3797e99 100644
--- a/ares_getaddrinfo.c
